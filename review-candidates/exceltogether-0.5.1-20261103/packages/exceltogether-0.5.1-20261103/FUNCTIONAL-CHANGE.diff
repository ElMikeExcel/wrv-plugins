diff -ruN '--exclude=*.class' '--exclude=*.jar' a/prev-src/com/winkreyes/exceltogether/PartyRepairBridge.java b/src/com/winkreyes/exceltogether/PartyRepairBridge.java
--- a/prev-src/com/winkreyes/exceltogether/PartyRepairBridge.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/com/winkreyes/exceltogether/PartyRepairBridge.java	2026-11-02 02:08:07.685194516 +0000
@@ -0,0 +1,52 @@
+package com.winkreyes.exceltogether;
+
+import java.util.List;
+import java.util.UUID;
+import java.util.logging.Logger;
+
+/**
+ * ExcelTogether 0.5.1 - the bridge between the plugin and its two Magic
+ * action classes (ExcelPartyRepairAction / ExcelRepairItemAction).
+ *
+ * Magic instantiates action classes itself (no-arg, via ActionFactory),
+ * so the actions cannot receive the PartyManager by constructor. The
+ * plugin binds it here at enable time instead - the same roster of
+ * record MagicLevelPartyLookup publishes - and unbinds at disable.
+ * Unbound (Magic link off, or any time outside enable), the roster of
+ * any player degrades to {self}: the actions then repair the caster
+ * alone rather than failing. Excel - Wink Reyes Valley.
+ */
+public final class PartyRepairBridge {
+    private PartyRepairBridge() {}
+
+    private static volatile PartyManager parties;
+    private static volatile Logger logger;
+
+    public static void bind(PartyManager partyManager, Logger log) {
+        parties = partyManager;
+        logger = log;
+    }
+
+    public static void unbind() {
+        parties = null;
+        logger = null;
+    }
+
+    public static boolean bound() { return parties != null; }
+
+    public static Logger logger() { return logger; }
+
+    /**
+     * The party roster for a player, leader first, the player included -
+     * or a list of just the player when he is solo or the bridge is
+     * unbound. Mirrors MagicLevelPartyLookup.partyMembers, in roster
+     * order. Offline-grace members are included here; the caller's
+     * selection (PartyRoster) gates on online / same-world.
+     */
+    public static List<UUID> partyMembersOf(UUID player) {
+        PartyManager pm = parties;
+        if (pm == null) return List.of(player);
+        PartyManager.Party party = pm.partyOf(player);
+        return party == null ? List.of(player) : party.members;
+    }
+}
diff -ruN '--exclude=*.class' '--exclude=*.jar' a/prev-src/com/winkreyes/exceltogether/PartyRoster.java b/src/com/winkreyes/exceltogether/PartyRoster.java
--- a/prev-src/com/winkreyes/exceltogether/PartyRoster.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/com/winkreyes/exceltogether/PartyRoster.java	2026-11-02 02:08:07.625194514 +0000
@@ -0,0 +1,59 @@
+package com.winkreyes.exceltogether;
+
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.entity.Player;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.UUID;
+import java.util.function.Function;
+
+/**
+ * ExcelTogether 0.5.1 - turns a party's member UUIDs into the players a
+ * party-wide effect may touch: online, in the caster's world, and (when
+ * maxRange > 0) within maxRange blocks of the caster. The caster is
+ * always first and always included - a solo caster's roster is himself,
+ * so a party spell cast alone still repairs the caster.
+ *
+ * Cross-world members are skipped: the roster is the targeting decision
+ * for the party-repair action (see REPAIREQUIP-REDESIGN.md §6-B, which
+ * specifies online + same-world), and Magic's per-entity step works in
+ * the caster's world context.
+ *
+ * Pure Bukkit-interface logic (Player / World are interfaces), so the
+ * selection rules are unit-testable headless. Excel - Wink Reyes Valley.
+ */
+public final class PartyRoster {
+    private PartyRoster() {}
+
+    /**
+     * @param caster       the casting player (always included)
+     * @param memberIds    the party roster including the caster; may be null
+     * @param maxRange     distance cap in blocks; 0 or negative means no cap
+     * @param onlinePlayer resolves a UUID to the online Player, or null
+     * @return the selected players, caster first, then roster order
+     */
+    public static List<Player> select(Player caster, Collection<UUID> memberIds, double maxRange,
+                                      Function<UUID, Player> onlinePlayer) {
+        LinkedHashSet<UUID> ids = new LinkedHashSet<>();
+        ids.add(caster.getUniqueId());
+        if (memberIds != null) ids.addAll(memberIds);
+        World world = caster.getWorld();
+        Location origin = caster.getLocation();
+        double capSquared = maxRange * maxRange;
+        List<Player> out = new ArrayList<>(ids.size());
+        for (UUID id : ids) {
+            boolean self = id.equals(caster.getUniqueId());
+            Player p = self ? caster : onlinePlayer.apply(id);
+            if (p == null || !p.isOnline()) continue;
+            if (!world.equals(p.getWorld())) continue;
+            if (!self && maxRange > 0
+                    && p.getLocation().distanceSquared(origin) > capSquared) continue;
+            out.add(p);
+        }
+        return out;
+    }
+}
