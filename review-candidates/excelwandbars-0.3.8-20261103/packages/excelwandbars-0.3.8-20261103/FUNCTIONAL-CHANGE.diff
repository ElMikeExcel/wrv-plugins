diff -ruN '--exclude=*.class' '--exclude=*.jar' a/prev-src/com/winkreyes/excelwandbars/core/JoinGuardPlan.java b/src/com/winkreyes/excelwandbars/core/JoinGuardPlan.java
--- a/prev-src/com/winkreyes/excelwandbars/core/JoinGuardPlan.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/com/winkreyes/excelwandbars/core/JoinGuardPlan.java	2026-11-02 19:12:55.751897232 +0000
@@ -0,0 +1,50 @@
+package com.winkreyes.excelwandbars.core;
+
+/**
+ * 0.3.8: the login wand-mode trap fix (Mike, Nov 2 2026: joins must land on
+ * the normal hotbar). Pure (no Bukkit/Magic types), unit-tested on the plain
+ * JVM.
+ *
+ * The defect: Magic restores a wand whose spell bar was open at logout with
+ * the bar open again at the next join, so the player lands in wand mode —
+ * and the exit paths are slot-dependent (tap the empty slot) or echo-guarded
+ * (the wand tap), while the menu compass other plugins hand out at join can
+ * sit in the very slot the exit needs. The guard's rule: a bar that is open
+ * inside the join grace window, with no sign the player has deliberately
+ * engaged since joining, is a RESTORED bar, not a chosen one — close it
+ * (Magic's own close, real items restored) so the join lands on the normal
+ * hotbar.
+ *
+ * "Deliberate engagement" is a slot pick or a bar open stamped after the
+ * join churn window ({@link #CHURN_MS}): in the first moments after a join
+ * the server itself stamps picks (the wand-slot sweep moving the wand into
+ * place), so stamps inside that window prove nothing and never exempt.
+ * Past the grace window the guard stops policing entirely: whatever the
+ * player has open then is their own session.
+ */
+public final class JoinGuardPlan {
+    private JoinGuardPlan() {}
+
+    /** Server-side join churn (wand move/select stamps) inside this window is not engagement. */
+    public static final long CHURN_MS = 1000;
+
+    public enum Decision { CLOSE, LEAVE }
+
+    /**
+     * @param enabled        the feature's config switch
+     * @param usesTapBar     the player's style opens a spell bar on hold (Tap bar / Tap to pick)
+     * @param barOpen        the wand's spell bar is open right now
+     * @param joinedAt       when this join was stamped (0 = never stamped, e.g. plugin reload)
+     * @param now            current time, same clock as joinedAt
+     * @param lastActivityAt last slot pick / deliberate bar open stamp (0 = none)
+     * @param graceMs        the join grace window
+     */
+    public static Decision decide(boolean enabled, boolean usesTapBar, boolean barOpen,
+                                  long joinedAt, long now, long lastActivityAt, long graceMs) {
+        if (!enabled || !usesTapBar || !barOpen) return Decision.LEAVE;
+        if (joinedAt <= 0) return Decision.LEAVE;
+        if (now - joinedAt > Math.max(0, graceMs)) return Decision.LEAVE;
+        if (lastActivityAt > joinedAt + CHURN_MS) return Decision.LEAVE;
+        return Decision.CLOSE;
+    }
+}
diff -ruN '--exclude=*.class' '--exclude=*.jar' a/prev-src/com/winkreyes/excelwandbars/core/PagerPlan.java b/src/com/winkreyes/excelwandbars/core/PagerPlan.java
--- a/prev-src/com/winkreyes/excelwandbars/core/PagerPlan.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/com/winkreyes/excelwandbars/core/PagerPlan.java	2026-11-02 19:12:55.751897232 +0000
@@ -0,0 +1,68 @@
+package com.winkreyes.excelwandbars.core;
+
+/**
+ * 0.3.8: the spell inventory's pager buttons (Mike's settled design, Nov 2 2026:
+ * "We can keep both" — the buttons AND the wand-click page cycle). Pure (no
+ * Bukkit/Magic types), unit-tested on the plain JVM.
+ *
+ * While the Tap bar spell inventory is open in the player's own inventory
+ * screen, the LAST TWO slots of the bottom row of the main grid — Bukkit
+ * player-inventory slots {@link #BACK_SLOT} (34) and {@link #FORWARD_SLOT}
+ * (35), the bottom-right pair — are pager buttons: back a page, forward a
+ * page, with the same wraparound as the wand-click / sneak cycle. The forward
+ * button carries the "Page X of Y" state in its lore. The buttons are
+ * presentation only: they are hard-protected from the drag-write and Arrange
+ * interpreters (the pager hook cancels every click or drag that touches
+ * them before those interpreters run, so a button can never be lifted,
+ * carried, written or counted as a spell), and they are removed again when
+ * the bar closes. The cost is the two grid slots while the bar is up.
+ *
+ * Buttons show only when the wand actually has more than one page: with one
+ * page there is nowhere to flip to.
+ */
+public final class PagerPlan {
+    private PagerPlan() {}
+
+    /** Bottom-right pair of the inventory grid: back is the left of the pair. */
+    public static final int BACK_SLOT = 34;
+    public static final int FORWARD_SLOT = 35;
+
+    public enum Button { NONE, BACK, FORWARD }
+
+    public static Button buttonAt(int playerInventorySlot) {
+        if (playerInventorySlot == BACK_SLOT) return Button.BACK;
+        if (playerInventorySlot == FORWARD_SLOT) return Button.FORWARD;
+        return Button.NONE;
+    }
+
+    public static boolean isButtonSlot(int playerInventorySlot) {
+        return buttonAt(playerInventorySlot) != Button.NONE;
+    }
+
+    /** Buttons only earn their two slots when there is somewhere to flip to. */
+    public static boolean shows(int pages) { return pages >= 2; }
+
+    /** Current page clamped into range (a wand can shrink under the open bar). */
+    public static int clamp(int page, int pages) {
+        if (pages < 1) return 0;
+        if (page < 0) return 0;
+        return Math.min(page, pages - 1);
+    }
+
+    /** The page a flip lands on, wrapping at both ends exactly like cycleHotbar. */
+    public static int target(int page, int pages, int dir) {
+        if (pages < 1) return 0;
+        int p = clamp(page, pages);
+        int step = dir < 0 ? -1 : 1;
+        return ((p + step) % pages + pages) % pages;
+    }
+
+    /** "Page 2 of 3" — the state line both buttons carry; the forward one leads with it. */
+    public static String stateLine(int page, int pages) {
+        int p = clamp(page, pages);
+        return "Page " + (p + 1) + " of " + Math.max(1, pages);
+    }
+
+    public static String backName() { return "◀ Back page"; }
+    public static String forwardName() { return "Next page ▶"; }
+}
