+// ExcelMenu — an Excel plugin by WinkReyesValley. (Excel signature — MikeExcel)
+// Excel signature - WRV maintained source; existing authorship notices preserved.
+package com.winkreyes.excelmenu.core.screens;
+
+/**
+ * The childproof picker's pure text logic, ported verbatim from
+ * ExcelBedrockMenu 1.5.28's ChildproofMenu (its Bukkit/GriefPrevention
+ * reads stay in the Bukkit screen; the words live here so the tests
+ * pin them). Nothing here changes trust itself: the screen runs
+ * "/childproof <name>" AS the player, so GriefPrevention does all
+ * permission checks and prints its own confirmations.
+ */
+public final class ChildproofCore {
+
+    public static final String TITLE = "Childproof a player";
+    public static final String YES = "Yes, childproof";
+    public static final String NO = "Cancel";
+    public static final String LIST_BODY =
+            "Tap who should only use doors and buttons in this claim (no building, breaking or chests).";
+    public static final String NOT_SET_UP_MESSAGE =
+            "§eChildproof isn't set up on this server yet. Ask an adult to check the server.";
+    public static final String OUTSIDE_CLAIM_MESSAGE =
+            "§eStand inside your claim first, then try again (or type it, like /childproof Alex). It only changes the claim you're standing in.";
+    public static final String NOBODY_MESSAGE =
+            "§eNobody else is online right now. You can also type the name, like /childproof Alex (example).";
+    public static final String TARGET_LEFT_MESSAGE = "§eThat player left. Nothing was changed.";
+    public static final String JAVA_LIST_HEADER =
+            "§6Childproof: click a name, then press Enter. Doors and buttons only, in this claim.";
+
+    /** Help text, always with a concrete example. */
+    public static String[] helpLines() {
+        return new String[]{
+            "§6Childproof §7- let little ones use doors, buttons and beds in your claim without breaking stuff.",
+            "§eStand in your claim and type §a/childproof Alex §7(example - type the player's name, not a nickname)",
+            "§eUndo it: §a/unchildproof Alex§7. Full trust again: §a/trust Alex",
+            "§eOn a phone? Tap §a/childproofmenu§e and pick the player from a list.",
+        };
+    }
+
+    /**
+     * The one confirmation line after the alias ran, given the
+     * verified state: "access", "none", "other:<level>", "outside"
+     * or "unknown" (the Bukkit screen's GriefPrevention read).
+     */
+    public static String resultLine(boolean childproof, String name, String state) {
+        if (state.equals("outside"))
+            return "§eYou weren't standing in a claim, so this changed ALL your claims. To change just one, stand in it and type §a/" + (childproof ? "childproof " : "unchildproof ") + name;
+        if (childproof && state.equals("access"))
+            return "§aDone! " + name + " can open doors, press buttons and use beds in this claim, but can't build, break things or open chests. Undo: §e/unchildproof " + name;
+        if (!childproof && state.equals("none"))
+            return "§aDone! " + name + " has no access to this claim now. Childproof again: §e/childproof " + name;
+        if (state.startsWith("other:"))
+            return "§e" + name + " still has " + state.substring(6) + " access here (maybe from public or a group trust). Check §a/trustlist§e.";
+        return "§eCheck the messages above. Type the player's exact name, like §a/" + (childproof ? "childproof " : "unchildproof ") + "Alex§e, while standing in your claim.";
+    }
+
+    /** Body text of the confirm form for a picked name. */
+    public static String confirmContent(String name) {
+        return name + " will only be able to use doors, buttons, levers and beds in this claim. "
+                + "They can't build, break things or open chests here. "
+                + "Undo: /unchildproof " + name + ". Full trust again: /trust " + name + ".";
+    }
+
+    /** The modal title for a picked name. */
+    public static String confirmTitle(String name) {
+        return "Childproof " + name + "?";
+    }
+
+    /** The fallback line when the confirm form cannot be sent. */
+    public static String typeItMessage(String name) {
+        return "§eType /childproof " + name + " to do it.";
+    }
+
+    /** The exact command run as the player for a picked name. */
+    public static String childproofCommand(String name) {
+        return "childproof " + name;
+    }
+
+    /**
+     * Button label: nickname plus the real name when they differ
+     * (".KidPlayer" shows as "Alex (.KidPlayer)"). The display name
+     * arrives already colour-stripped.
+     */
+    public static String label(String strippedDisplay, String name) {
+        String d = strippedDisplay == null ? "" : strippedDisplay.trim();
+        String core = d.startsWith("~") ? d.substring(1) : d; // Essentials nick prefix
+        if (core.isEmpty() || core.equalsIgnoreCase(name)) return name;
+        return core + " (" + name + ")";
+    }
+
+    private ChildproofCore() {}
+}
diff -ruN '--exclude=*.class' '--exclude=*.jar' a/phase-1-src/main/java/com/winkreyes/excelmenu/core/screens/CommandsPanel.java b/phase-2-src/main/java/com/winkreyes/excelmenu/core/screens/CommandsPanel.java
--- a/phase-1-src/main/java/com/winkreyes/excelmenu/core/screens/CommandsPanel.java	1970-01-01 00:00:00.000000000 +0000
+++ b/phase-2-src/main/java/com/winkreyes/excelmenu/core/screens/CommandsPanel.java	2026-10-31 00:00:00.000000000 +0000
@@ -0,0 +1,78 @@
+// ExcelMenu — an Excel plugin by WinkReyesValley. (Excel signature — MikeExcel)
+// Excel signature - WRV maintained source; existing authorship notices preserved.
+package com.winkreyes.excelmenu.core.screens;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * The /servercommands chat panel, ported from ExcelBedrockMenu
+ * 1.5.28's commandsPanelLines / catalogGroupIndexFor — same design
+ * language (gold headers, aqua markers, yellow commands, gray
+ * descriptions), but the rows now come from the commands_menu
+ * registry (the Bukkit screen resolves them per viewer) instead of
+ * the retired hand-kept catalogue. Group order and names are the
+ * layout's; the registry has nine groups where the old catalogue
+ * had eight (the conversion's Fixes & Help split).
+ */
+public final class CommandsPanel {
+
+    /** One panel row: the command as displayed, and its description. */
+    public record Row(String display, String description) {}
+
+    /**
+     * Resolves a /servercommands argument to a group index: a
+     * 1-based group number, or a case-insensitive prefix of the
+     * group name ("claims" for Claims & Land). -1 when nothing
+     * matches.
+     */
+    public static int groupIndexFor(String arg, List<String> groupNames) {
+        if (arg == null) return -1;
+        String wanted = arg.trim().toLowerCase(Locale.ROOT);
+        if (wanted.isEmpty()) return -1;
+        try {
+            int n = Integer.parseInt(wanted);
+            return (n >= 1 && n <= groupNames.size()) ? n - 1 : -1;
+        } catch (NumberFormatException ignored) {
+            // not a number; fall through to name matching
+        }
+        for (int g = 0; g < groupNames.size(); g++) {
+            if (groupNames.get(g).toLowerCase(Locale.ROOT).startsWith(wanted)) {
+                return g;
+            }
+        }
+        return -1;
+    }
+
+    /**
+     * The panel lines. group -1 prints every group; otherwise just
+     * the one group, with the pointer back to the whole list.
+     */
+    public static List<String> panelLines(int group, List<String> groupNames,
+                                          List<List<Row>> rowsByGroup) {
+        List<String> lines = new ArrayList<>();
+        if (group >= 0) {
+            lines.add("§6— Server Commands: " + groupNames.get(group) + " —");
+            addGroup(lines, groupNames.get(group), rowsByGroup.get(group));
+            lines.add("§7/servercommands shows every group.");
+            return lines;
+        }
+        lines.add("§6— Server Commands —");
+        for (int g = 0; g < groupNames.size(); g++) {
+            addGroup(lines, groupNames.get(g), rowsByGroup.get(g));
+        }
+        lines.add("§7That is the whole list. In the menu, tap Server Commands "
+                + "for tap-to-run buttons.");
+        return lines;
+    }
+
+    private static void addGroup(List<String> lines, String name, List<Row> rows) {
+        lines.add("§6" + name);
+        for (Row r : rows) {
+            lines.add("§b» §e" + r.display() + " §7- " + r.description());
+        }
+    }
+
+    private CommandsPanel() {}
+}
diff -ruN '--exclude=*.class' '--exclude=*.jar' a/phase-1-src/main/java/com/winkreyes/excelmenu/core/screens/ConfirmTargets.java b/phase-2-src/main/java/com/winkreyes/excelmenu/core/screens/ConfirmTargets.java
--- a/phase-1-src/main/java/com/winkreyes/excelmenu/core/screens/ConfirmTargets.java	1970-01-01 00:00:00.000000000 +0000
+++ b/phase-2-src/main/java/com/winkreyes/excelmenu/core/screens/ConfirmTargets.java	2026-10-31 00:00:00.000000000 +0000
@@ -0,0 +1,100 @@
+// ExcelMenu — an Excel plugin by WinkReyesValley. (Excel signature — MikeExcel)
+// Excel signature - WRV maintained source; existing authorship notices preserved.
+package com.winkreyes.excelmenu.core.screens;
+
+import java.util.List;
+
+/**
+ * The four teleport-confirmation targets (DESIGN-2.0 §2.4 forced
+ * change 2): the doors that used to open the teleport_confirm_*
+ * definition menus now route to the confirmation-gate service. Each
+ * target carries BOTH old columns' presentation verbatim — the Java
+ * definition's chest (title, icon, info name/lore, Yes/Cancel lore)
+ * and the Bedrock modal's title/content (ExcelBedrockMenu's
+ * teleportConfirmTitle/Content) — and the Yes action its columns ran:
+ *
+ *   spawn     the compass Spawn door. Java: [console] spawn (the
+ *             EssentialsX spawn, per the definition's own 2026-10-24
+ *             note). Bedrock: the village-fallback path (console
+ *             spawn, then the configured village point if the player
+ *             is still in the guild world). Union: the fallback path
+ *             — it differs from the plain command only where that
+ *             command would strand the player in the guild world.
+ *   spawncmd  the catalogue /spawn row. Both columns: [player] spawn.
+ *   guild     the Adventurers Guild doors. Both columns: [player] ag.
+ *   home      Both columns: [player] home. (The Java definition
+ *             existed; the Bedrock gate carried the same target; no
+ *             registry entry dispatches here — the target completes
+ *             the retired set.)
+ */
+public final class ConfirmTargets {
+
+    public enum Kind { SPAWN_FALLBACK, PLAYER_COMMAND }
+
+    public record Target(String definitionId,
+                         String modalTitle, String modalContent,
+                         String chestTitle, String icon, String infoName,
+                         List<String> infoLore, String yesLore,
+                         Kind kind, String command) {}
+
+    public static final String YES_LABEL = "Yes, teleport";
+    public static final String NO_LABEL = "Cancel";
+    public static final String CANCEL_LORE = "&7Stay where I am";
+
+    private static final Target SPAWN = new Target(
+            "teleport_confirm_spawn",
+            "Teleport to spawn?",
+            "This takes you back to the village spawn right away.",
+            "&6&lTeleport to Spawn?", "COMPASS", "&e&lSpawn",
+            List.of("&7Teleport back to the village"),
+            "&7Take me to spawn",
+            Kind.SPAWN_FALLBACK, null);
+
+    private static final Target SPAWNCMD = new Target(
+            "teleport_confirm_spawncmd",
+            "Teleport to spawn?",
+            "This takes you back to the village spawn right away.",
+            "&6&lTeleport to Spawn?", "LODESTONE", "&e&lSpawn",
+            List.of("&7Teleport back to the village spawn"),
+            "&7Take me to spawn",
+            Kind.PLAYER_COMMAND, "spawn");
+
+    private static final Target GUILD = new Target(
+            "teleport_confirm_guild",
+            "Teleport to the Adventurers Guild?",
+            "This takes you to the Adventurers Guild right away.",
+            "&6&lTeleport to the Guild?", "BELL", "&e&lAdventurers Guild",
+            List.of("&7Teleport to the EliteMobs", "&7guild hall"),
+            "&7Take me to the guild hall",
+            Kind.PLAYER_COMMAND, "ag");
+
+    private static final Target HOME = new Target(
+            "teleport_confirm_home",
+            "Teleport home?",
+            "This takes you home right away.",
+            "&6&lTeleport Home?", "RED_BED", "&e&lHome",
+            List.of("&7Teleport to your home"),
+            "&7Take me home",
+            Kind.PLAYER_COMMAND, "home");
+
+    private static final List<Target> ALL = List.of(SPAWN, SPAWNCMD, GUILD, HOME);
+
+    /** The target a retired definition id routes to, or null. */
+    public static Target byDefinitionId(String menuId) {
+        if (menuId == null) return null;
+        for (Target t : ALL) {
+            if (t.definitionId().equals(menuId)) return t;
+        }
+        return null;
+    }
+
+    public static boolean isConfirmation(String menuId) {
+        return byDefinitionId(menuId) != null;
+    }
+
+    public static List<Target> all() {
+        return ALL;
+    }
+
+    private ConfirmTargets() {}
+}
