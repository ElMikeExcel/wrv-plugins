+            + "\"player\":\"RigPlayer\",\"player_uuid\":\"u-rig\","
+            + "\"deposits\":[{\"id\":\"minecraft:ominous_bottle\",\"count\":8}],"
+            + "\"withdrawals\":[{\"id\":\"minecraft:egg\",\"count\":1}],"
