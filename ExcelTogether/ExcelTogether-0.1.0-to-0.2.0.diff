@@ -0,0 +1,22 @@
+package com.winkreyes.exceltogether;
+
+import java.util.List;
+import java.util.function.Consumer;
+import java.util.function.IntConsumer;
+
+/** Bedrock form sender. Every method returns false if the form could not be shown (caller falls back to chat). */
+public interface Forms {
+    /** cb gets the tapped button index, or -1 when the form is closed. */
+    boolean simple(PlayerView p, String title, String content, List<String> buttons, IntConsumer cb);
+    /** cb gets true for the first button, false for the second or when closed. */
+    boolean modal(PlayerView p, String title, String content, String yes, String no, Consumer<Boolean> cb);
+    /** Unused by ExcelTogether, kept so the shared GeyserForms code compiles unchanged. */
+    boolean custom(PlayerView p, String title, List<Field> fields, Consumer<List<Object>> cb);
+
+    final class Field {
+        public enum Kind { INPUT, DROPDOWN, TOGGLE }
+        public final Kind kind; public final String label; public final String hint; public final String def;
+        public final List<String> options; public final int defIndex; public final boolean defBool;
+        private Field(Kind k, String l, String h, String d, List<String> o, int di, boolean db) { kind = k; label = l; hint = h; def = d; options = o; defIndex = di; defBool = db; }
+    }
+}
diff -ruN o/src/com/winkreyes/exceltogether/GeyserForms.java n/src/com/winkreyes/exceltogether/GeyserForms.java
--- o/src/com/winkreyes/exceltogether/GeyserForms.java	1969-12-31 18:00:00.000000000 -0600
+++ n/src/com/winkreyes/exceltogether/GeyserForms.java	2026-10-16 00:00:00.000000000 -0500
@@ -0,0 +1,158 @@
+package com.winkreyes.exceltogether;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.function.Consumer;
+import java.util.function.IntConsumer;
+import java.util.logging.Logger;
+
+/**
+ * Bedrock forms through Geyser's own class loader (same approach as ExcelBedrockMenu), so no compile-time
+ * Geyser or Cumulus dependency. Building is separate from sending so tests can build real Cumulus forms.
+ */
+public final class GeyserForms implements Forms {
+    private final Logger log;
+    public GeyserForms(Logger log) { this.log = log; }
+
+    static ClassLoader geyserLoader() {
+        Plugin g = Bukkit.getPluginManager().getPlugin("Geyser-Spigot");
+        return g != null && g.isEnabled() ? g.getClass().getClassLoader() : null;
+    }
+
+    /** True if Geyser says this UUID is a Bedrock player. */
+    public static boolean isBedrock(Player pl) {
+        try {
+            ClassLoader l = geyserLoader();
+            if (l == null) return false;
+            Class<?> api = Class.forName("org.geysermc.geyser.api.GeyserApi", true, l);
+            Object a = api.getMethod("api").invoke(null);
+            return Boolean.TRUE.equals(api.getMethod("isBedrockPlayer", UUID.class).invoke(a, pl.getUniqueId()));
+        } catch (Throwable t) { return false; }
+    }
+
+    // ---- builders (public static for tests) ----
+    static Object newBuilder(ClassLoader l, String form) throws Exception {
+        return Class.forName("org.geysermc.cumulus.form." + form, true, l).getMethod("builder").invoke(null);
+    }
+    static Class<?> iface(ClassLoader l, String name) throws Exception { return Class.forName(name, true, l); }
+    static void call(Object b, Class<?> type, String m, Class<?>[] sig, Object... args) throws Exception {
+        type.getMethod(m, sig).invoke(b, args);
+    }
+
+
+    /** One handler for every outcome: valid reply goes to "valid", closed or invalid goes to "other". */
+    static void attach(Object b, Class<?> fb, ClassLoader l, Consumer<Object> valid, Runnable other) throws Exception {
+        Class<?> res = iface(l, "org.geysermc.cumulus.response.result.FormResponseResult");
+        Class<?> ok = iface(l, "org.geysermc.cumulus.response.result.ValidFormResponseResult");
+        Method isValid = res.getMethod("isValid"), response = ok.getMethod("response");
+        java.util.function.BiConsumer<Object, Object> h = (form, r) -> {
+            try {
+                if (Boolean.TRUE.equals(isValid.invoke(r))) { valid.accept(response.invoke(r)); return; }
+            } catch (Exception e) { /* fall through to other */ }
+            other.run();
+        };
+        call(b, fb, "resultHandler", new Class<?>[]{java.util.function.BiConsumer.class}, h);
+    }
+
+    public static Object buildSimple(ClassLoader l, String title, String content, List<String> buttons, IntConsumer cb) throws Exception {
+        Object b = newBuilder(l, "SimpleForm");
+        Class<?> bt = iface(l, "org.geysermc.cumulus.form.SimpleForm$Builder");
+        Class<?> fb = iface(l, "org.geysermc.cumulus.form.util.FormBuilder");
+        Class<?> resp = iface(l, "org.geysermc.cumulus.response.SimpleFormResponse");
+        call(b, fb, "title", new Class<?>[]{String.class}, title);
+        call(b, bt, "content", new Class<?>[]{String.class}, content);
+        for (String s : buttons) call(b, bt, "button", new Class<?>[]{String.class}, s);
+        Method id = resp.getMethod("clickedButtonId");
+        Consumer<Object> valid = r -> { try { cb.accept((Integer) id.invoke(r)); } catch (Exception e) { cb.accept(-1); } };
+        attach(b, fb, l, valid, () -> cb.accept(-1));
+        return fb.getMethod("build").invoke(b);
+    }
+
+    public static Object buildModal(ClassLoader l, String title, String content, String yes, String no, Consumer<Boolean> cb) throws Exception {
+        Object b = newBuilder(l, "ModalForm");
+        Class<?> bt = iface(l, "org.geysermc.cumulus.form.ModalForm$Builder");
+        Class<?> fb = iface(l, "org.geysermc.cumulus.form.util.FormBuilder");
+        Class<?> resp = iface(l, "org.geysermc.cumulus.response.ModalFormResponse");
+        call(b, fb, "title", new Class<?>[]{String.class}, title);
+        call(b, bt, "content", new Class<?>[]{String.class}, content);
+        call(b, bt, "button1", new Class<?>[]{String.class}, yes);
+        call(b, bt, "button2", new Class<?>[]{String.class}, no);
+        Method res = resp.getMethod("clickedFirst");
+        Consumer<Object> valid = r -> { try { cb.accept(Boolean.TRUE.equals(res.invoke(r))); } catch (Exception e) { cb.accept(false); } };
+        attach(b, fb, l, valid, () -> cb.accept(false));
+        return fb.getMethod("build").invoke(b);
+    }
+
+    public static Object buildCustom(ClassLoader l, String title, List<Forms.Field> fields, Consumer<List<Object>> cb) throws Exception {
+        Object b = newBuilder(l, "CustomForm");
+        Class<?> bt = iface(l, "org.geysermc.cumulus.form.CustomForm$Builder");
+        Class<?> fb = iface(l, "org.geysermc.cumulus.form.util.FormBuilder");
+        Class<?> resp = iface(l, "org.geysermc.cumulus.response.CustomFormResponse");
+        call(b, fb, "title", new Class<?>[]{String.class}, title);
+        for (Forms.Field f : fields) {
+            switch (f.kind) {
+                case INPUT -> call(b, bt, "input", new Class<?>[]{String.class, String.class, String.class}, f.label, f.hint == null ? "" : f.hint, f.def == null ? "" : f.def);
+                case DROPDOWN -> call(b, bt, "dropdown", new Class<?>[]{String.class, List.class, int.class}, f.label, f.options, f.defIndex);
+                case TOGGLE -> call(b, bt, "toggle", new Class<?>[]{String.class, boolean.class}, f.label, f.defBool);
+            }
+        }
+        Method in = resp.getMethod("asInput", int.class), dd = resp.getMethod("asDropdown", int.class), tg = resp.getMethod("asToggle", int.class);
+        Consumer<Object> valid = r -> {
+            List<Object> out = new ArrayList<>();
+            try {
+                for (int i = 0; i < fields.size(); i++) {
+                    switch (fields.get(i).kind) {
+                        case INPUT -> { Object v = in.invoke(r, i); out.add(v == null ? "" : v); }
+                        case DROPDOWN -> out.add(dd.invoke(r, i));
+                        case TOGGLE -> out.add(tg.invoke(r, i));
+                    }
+                }
+            } catch (Exception e) { cb.accept(null); return; }
+            cb.accept(out);
+        };
+        attach(b, fb, l, valid, () -> cb.accept(null));
+        return fb.getMethod("build").invoke(b);
+    }
+
+    // ---- sending ----
+    private boolean send(PlayerView p, java.util.concurrent.Callable<Object> builder) {
+        try {
+            ClassLoader l = geyserLoader();
+            if (l == null) return false;
+            Class<?> api = Class.forName("org.geysermc.geyser.api.GeyserApi", true, l);
+            Object a = api.getMethod("api").invoke(null);
+            Object conn = api.getMethod("connectionByUuid", UUID.class).invoke(a, p.id());
+            if (conn == null) return false;
+            Object form = builder.call();
+            for (Method m : conn.getClass().getMethods()) {
+                if (m.getName().equals("sendForm") && m.getParameterCount() == 1 && m.getParameterTypes()[0].isAssignableFrom(form.getClass())) {
+                    return Boolean.TRUE.equals(m.invoke(conn, form));
+                }
+            }
+            log.warning("No compatible sendForm on the Geyser connection");
+            return false;
+        } catch (Throwable t) {
+            log.warning("Bedrock form failed: " + t.getClass().getSimpleName() + ": " + t.getMessage());
+            return false;
+        }
+    }
+
+    @Override public boolean simple(PlayerView p, String title, String content, List<String> buttons, IntConsumer cb) {
+        ClassLoader l = geyserLoader();
+        return l != null && send(p, () -> buildSimple(l, title, content, buttons, cb));
+    }
+    @Override public boolean modal(PlayerView p, String title, String content, String yes, String no, Consumer<Boolean> cb) {
+        ClassLoader l = geyserLoader();
+        return l != null && send(p, () -> buildModal(l, title, content, yes, no, cb));
+    }
+    @Override public boolean custom(PlayerView p, String title, List<Forms.Field> fields, Consumer<List<Object>> cb) {
+        ClassLoader l = geyserLoader();
+        return l != null && send(p, () -> buildCustom(l, title, fields, cb));
+    }
+}
diff -ruN o/src/com/winkreyes/exceltogether/McmmoLink.java n/src/com/winkreyes/exceltogether/McmmoLink.java
--- o/src/com/winkreyes/exceltogether/McmmoLink.java	1969-12-31 18:00:00.000000000 -0600
+++ n/src/com/winkreyes/exceltogether/McmmoLink.java	2026-10-16 00:00:00.000000000 -0500
@@ -0,0 +1,42 @@
+package com.winkreyes.exceltogether;
+
+import java.util.UUID;
+import java.util.function.Predicate;
+
+/**
+ * Optional mirror of an ExcelTogether party into the mcMMO party system. ExcelTogether is always the
+ * source of truth: every call here may fail or do nothing, and the ExcelTogether party carries on regardless.
+ * mcMMO is a soft dependency: with mcMMO absent, disabled or too different, NONE is used.
+ */
+public interface McmmoLink {
+    enum Mirror {
+        OK,                     // mcMMO invite set, or player joined the mcMMO party
+        ABSENT,                 // mcMMO missing, party system off, or link switched off
+        TARGET_IN_OTHER_PARTY,  // the other player is already in a different mcMMO party
+        FULL,                   // mcMMO party size limit reached
+        LOCKED,                 // mcMMO party is locked and the inviter is not its leader
+        NOT_READY,              // a player or their mcMMO profile is not loaded right now
+        ERROR                   // anything unexpected; logged, never shown to players
+    }
+
+    boolean available();
+    /** Called after ExcelTogether accepted a new invite. Creates the inviter's mcMMO party if needed and sets the invite. */
+    Mirror invite(UUID inviter, UUID target, String partyNameHint);
+    /** Called after the invitee accepted in ExcelTogether. */
+    Mirror accept(UUID target, UUID inviter, String partyNameHint);
+    /** Invite declined or expired: clear the mcMMO invite we set. */
+    void cancel(UUID target, UUID inviter);
+    /** Player left, was kicked, or the party ended: take them out of the mcMMO party, only if we put them there. */
+    void leave(UUID id);
+    /** Housekeeping: drop mcMMO parties we created that never got a second member. */
+    void cleanup(Predicate<UUID> inviterHasOpenInvites);
+
+    McmmoLink NONE = new McmmoLink() {
+        public boolean available() { return false; }
+        public Mirror invite(UUID a, UUID b, String h) { return Mirror.ABSENT; }
+        public Mirror accept(UUID a, UUID b, String h) { return Mirror.ABSENT; }
+        public void cancel(UUID a, UUID b) {}
+        public void leave(UUID a) {}
+        public void cleanup(Predicate<UUID> p) {}
+    };
+}
diff -ruN o/src/com/winkreyes/exceltogether/NameMatch.java n/src/com/winkreyes/exceltogether/NameMatch.java
--- o/src/com/winkreyes/exceltogether/NameMatch.java	1969-12-31 18:00:00.000000000 -0600
+++ n/src/com/winkreyes/exceltogether/NameMatch.java	2026-10-16 00:00:00.000000000 -0500
@@ -0,0 +1,56 @@
+package com.winkreyes.exceltogether;
+
+import java.util.*;
+
+/**
+ * Finds a player from what someone typed. Handles Floodgate dot prefixes (".coolgirlkail" can be typed as
+ * "coolgirlkail"), nicknames with color codes, case, and unique prefixes. Pure logic, no Bukkit.
+ */
+public final class NameMatch {
+    private NameMatch() {}
+
+    public static final class Cand {
+        public final UUID id; public final String real; public final String nick;
+        public Cand(UUID id, String real, String nick) { this.id = id; this.real = real == null ? "" : real; this.nick = nick == null ? "" : nick; }
+    }
+    public static final class Result {
+        public final Cand found; public final List<Cand> ambiguous;
+        Result(Cand f, List<Cand> a) { found = f; ambiguous = a; }
+        public boolean isFound() { return found != null; }
+        public boolean isAmbiguous() { return found == null && !ambiguous.isEmpty(); }
+    }
+
+    /** Lowercase, color codes removed, leading "." "*" "~" removed, trimmed. */
+    public static String norm(String s) {
+        if (s == null) return "";
+        String x = s.replaceAll("(?i)[\u00a7&][0-9a-fk-or]", "").trim().toLowerCase(Locale.ROOT);
+        while (x.startsWith(".") || x.startsWith("*") || x.startsWith("~")) x = x.substring(1);
+        return x;
+    }
+
+    public static Result find(String query, Collection<Cand> cands) {
+        if (query == null || query.trim().isEmpty()) return new Result(null, List.of());
+        String raw = query.trim().replaceAll("(?i)[\u00a7&][0-9a-fk-or]", "").toLowerCase(Locale.ROOT);
+        String q = norm(query);
+        if (q.isEmpty()) return new Result(null, List.of());
+        // 1 exact real name, dot included (".kail" only matches the Bedrock "Kail")
+        Result r = tier(cands, c -> c.real.toLowerCase(Locale.ROOT).equals(raw));
+        if (r != null) return r;
+        // 2 exact real name without dot, 3 exact nickname
+        r = tier(cands, c -> norm(c.real).equals(q));
+        if (r != null) return r;
+        r = tier(cands, c -> norm(c.nick).equals(q));
+        if (r != null) return r;
+        // 4 unique prefix of real name or nickname
+        r = tier(cands, c -> norm(c.real).startsWith(q) || norm(c.nick).startsWith(q));
+        return r != null ? r : new Result(null, List.of());
+    }
+
+    private static Result tier(Collection<Cand> cands, java.util.function.Predicate<Cand> p) {
+        List<Cand> hit = new ArrayList<>();
+        for (Cand c : cands) if (p.test(c)) hit.add(c);
+        if (hit.isEmpty()) return null;
+        if (hit.size() == 1) return new Result(hit.get(0), List.of());
+        return new Result(null, hit);
+    }
+}
