--- src-0.2.6/src/com/winkreyes/excelwandbars/core/SpellEffects.java	1969-12-31 18:00:00.000000000 -0600
+++ src/src/com/winkreyes/excelwandbars/core/SpellEffects.java	2026-10-26 11:07:32.874317588 -0500
