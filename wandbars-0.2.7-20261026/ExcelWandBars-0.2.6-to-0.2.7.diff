+            out.add("You wait " + Durations.ms(warm) + ", then you go");
+        }
+        if (r.castMs > 0 || warm > 0) {
+            if (cancelDmg > 0) out.add(cancelDmg < 0.01 ? "Getting hurt stops it" : "A hit over " + hearts(cancelDmg) + " stops it");
