+    }
+
+    private void action() {
+        Jobs.action(jPlayer, info, null, null, null);
+    }
+
+    private void replay(BufferedPayment payment) {
+        Jobs.perform(jPlayer, info, payment, job, null, null, null);
+    }
+
+    private BufferedPayment seedPayment() {
+        return new BufferedPayment(player, CurrencyType.generate(3D, 10D, 4D));
+    }
+
+    private void assertPaid(double xp) {
+        Map<CurrencyType, Double> payment = paid.getLast();
+        assertEquals(xp, payment.getOrDefault(CurrencyType.EXP, 0D), 1e-9);
+        assertEquals(3D, payment.get(CurrencyType.MONEY), 1e-9);
+        assertEquals(4D, payment.get(CurrencyType.POINTS), 1e-9);
+    }
+
+    @Test
+    void actionAndRepeatedFastAwardsUseOneCurrentBonusAndDoNotPolluteCache() {
+        action();
+        assertEquals(24D, progress.getExperience(), 1e-9);
+        assertPaid(24D);
+        BufferedPayment cached = Jobs.FASTPAYMENT.get(jPlayer.getUniqueId()).getPayment();
+        assertEquals(10D, cached.get(CurrencyType.EXP), 1e-9);
+        replay(cached);
+        assertEquals(48D, progress.getExperience(), 1e-9);
+        assertPaid(24D);
+        when(mcMMO.getJobsXpBonusMultiplier(player)).thenReturn(1.2D);
+        replay(cached);
+        assertEquals(60D, progress.getExperience(), 1e-9);
+        assertPaid(12D);
+        assertEquals(10D, cached.get(CurrencyType.EXP), 1e-9);
+        verify(mcMMO, times(3)).notifyJobsXpGain(player);
+        // Preserve upstream pre-Excel-bonus limit consumption; live limits are disabled.
+        verify(jPlayer, atLeastOnce()).isUnderLimit(CurrencyType.EXP, 10D);
+        verify(jPlayer, never()).isUnderLimit(CurrencyType.EXP, 24D);
+    }
+
+    @Test
+    void cachedEventMutationReachesActualStoredProgressionAndLog() {
+        eventHandler = event -> {
+            if (event instanceof JobsPrePaymentEvent pre) pre.setExp(15D);
+            if (event instanceof JobsExpGainEvent gain) {
+                assertEquals(15D, gain.getExp(), 1e-9);
+                gain.setExp(20D);
+            }
+        };
+        replay(seedPayment());
+        assertPaid(48D);
+        assertEquals(48D, progress.getExperience(), 1e-9);
+        verify(logging).recordToLog(eq(jPlayer), eq(info), argThat(values -> values.get(CurrencyType.EXP) == 48D));
+    }
+
+    @Test
+    void normalAndFastPrePaymentCancellationDoNotAwardOrNotify() {
+        eventHandler = event -> { if (event instanceof JobsPrePaymentEvent pre) pre.setCancelled(true); };
+        action();
+        replay(seedPayment());
+        assertEquals(0D, progress.getExperience());
+        assertTrue(paid.isEmpty());
+        verify(mcMMO, never()).notifyJobsXpGain(any());
+    }
+
+    @Test
+    void xpCancellationPreservesUpstreamMoneyAndPointsSemantics() {
+        eventHandler = event -> { if (event instanceof JobsExpGainEvent gain) gain.setCancelled(true); };
+        action();
+        assertPaid(0D); // Standard action still pays money and points.
+        replay(seedPayment()); // Upstream fast path cancels the complete payment.
+        assertEquals(1, paid.size());
+        assertEquals(0D, progress.getExperience());
+        verify(mcMMO, never()).notifyJobsXpGain(any());
+    }
+
+    @Test
+    void realLevelUpCountsAsGainButMaxLevelCapDoesNotNotify() {
+        newProgress(1, 95D);
+        replay(seedPayment());
+        assertEquals(2, progress.getLevel());
+        assertEquals(19D, progress.getExperience(), 1e-9);
+        verify(manager).performLevelUp(jPlayer, job, 1);
+        verify(mcMMO).notifyJobsXpGain(player);
+        clearInvocations(mcMMO);
+        newProgress(200, 100D);
+        replay(seedPayment());
+        assertEquals(200, progress.getLevel());
+        assertEquals(100D, progress.getExperience());
+        verify(mcMMO, never()).notifyJobsXpGain(any());
+    }
+
+    @Test
+    void fractionalXpIsNotRoundedAndNonpositiveXpIsNotBoosted() {
+        when(jobInfo.getExperience(anyDouble(), anyInt(), anyInt())).thenReturn(0.125D);
+        action();
+        assertEquals(0.3D, progress.getExperience(), 1e-12);
+        assertPaid(0.3D);
+        clearInvocations(mcMMO);
+        when(jobInfo.getExperience(anyDouble(), anyInt(), anyInt())).thenReturn(-0.1D);
+        replay(new BufferedPayment(player, CurrencyType.generate(3D, -0.1D, 4D)));
+        assertEquals(0.2D, progress.getExperience(), 1e-12);
+        assertPaid(-0.1D);
+        verify(mcMMO, never()).notifyJobsXpGain(any());
+    }
+
+    @Test
+    void replayRecalculatesNativeAndExternalXpBoostsWithoutCompoundingCachedEvents() {
+        Boost nativeBoost = mock(Boost.class);
+        when(nativeBoost.getFinalAmount(eq(CurrencyType.EXP), anyDouble()))
+            .thenAnswer(call -> call.<Double>getArgument(1) * 1.5D);
+        when(nativeBoost.getFinalAmount(eq(CurrencyType.MONEY), anyDouble()))
+            .thenAnswer(call -> call.<Double>getArgument(1));
+        when(nativeBoost.getFinalAmount(eq(CurrencyType.POINTS), anyDouble()))
+            .thenAnswer(call -> call.<Double>getArgument(1));
+        when(manager.getFinalBonus(eq(jPlayer), eq(job), (org.bukkit.entity.Entity) any(), (org.bukkit.entity.LivingEntity) any())).thenReturn(nativeBoost);
+        eventHandler = event -> {
+            if (event instanceof JobsPrePaymentEvent pre) pre.setExp(pre.getExp() * 2D);
+            if (event instanceof JobsExpGainEvent gain) gain.setExp(gain.getExp() * 2D);
+        };
+        action(); // 10 * pre-event 2 * native 1.5 * exp-event 2 * Excel 2.4 = 144.
+        assertEquals(144D, progress.getLastExperience(), 1e-9);
+        assertPaid(144D);
+        BufferedPayment cached = Jobs.FASTPAYMENT.get(jPlayer.getUniqueId()).getPayment();
+        assertEquals(60D, cached.get(CurrencyType.EXP));
+        replay(cached);
+        assertEquals(288D, progress.getLastExperience(), 1e-9);
+        assertPaid(144D);
+        assertEquals(60D, cached.get(CurrencyType.EXP));
+    }
+
+    @Test
+    void noMcMMOAndUnsupportedMcMMOFailClosedAndCanAppearLater() {
+        when(plugins.getPlugin("mcMMO")).thenReturn(null);
+        replay(seedPayment());
+        assertEquals(10D, progress.getExperience());
+        when(plugins.getPlugin("mcMMO")).thenReturn(mcMMO);
+        when(mcMMO.isJobsXpBonusSupported()).thenReturn(false);
+        replay(seedPayment());
+        assertEquals(20D, progress.getExperience());
+        when(mcMMO.isJobsXpBonusSupported()).thenReturn(true);
+        replay(seedPayment());
+        assertEquals(44D, progress.getExperience());
+    }
+
+    @ParameterizedTest
+    @ValueSource(doubles = {1D, 1.25D, 1.2D, 1.5D})
+    void soloTogetherWeekendAndStackedFactorsMatchOnNormalAndCachedPaths(double factor) {
+        when(mcMMO.getJobsXpBonusMultiplier(player)).thenReturn(factor);
+        action();
+        assertPaid(10D * factor);
+        replay(Jobs.FASTPAYMENT.get(jPlayer.getUniqueId()).getPayment());
+        assertPaid(10D * factor);
+        assertEquals(20D * factor, progress.getExperience(), 1e-9);
+        verify(mcMMO, times(2)).notifyJobsXpGain(player);
+    }
+
+    @ParameterizedTest
+    @ValueSource(doubles = {Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, -1D, 0D, 0.5D, Double.MAX_VALUE})
+    void malformedOrOverflowingMultipliersKeepOriginalXp(double factor) {
+        when(mcMMO.getJobsXpBonusMultiplier(player)).thenReturn(factor);
+        replay(seedPayment());
+        assertPaid(10D);
+        assertEquals(10D, progress.getExperience());
+    }
+
+    @Test
+    void cachedXpEligibilityHandlesRemovedJobMissingActionAndMaxLevelStop() {
+        when(job.getJobInfo(eq(info), anyInt())).thenReturn(null);
+        replay(seedPayment());
+        assertPaid(0D);
+        assertEquals(0D, progress.getExperience());
+        when(job.getJobInfo(eq(info), anyInt())).thenReturn(jobInfo);
+        config.disablePaymentIfMaxLevelReached = true;
+        newProgress(200, 50D);
+        replay(seedPayment());
+        assertPaid(0D);
+        assertEquals(50D, progress.getExperience());
+        when(jPlayer.getJobProgression(job)).thenReturn(null);
+        assertDoesNotThrow(() -> replay(seedPayment()));
+        assertPaid(0D);
+        verify(mcMMO, never()).notifyJobsXpGain(any());
+    }
+
+    @Test
+    void zeroXpOrAllCurrenciesBlockedNeverNotify() {
+        when(jobInfo.getExperience(anyDouble(), anyInt(), anyInt())).thenReturn(0D);
+        replay(seedPayment());
+        assertPaid(0D);
+        when(jobInfo.getExperience(anyDouble(), anyInt(), anyInt())).thenReturn(10D);
+        when(jPlayer.isUnderLimit(any(), anyDouble())).thenReturn(false);
+        replay(seedPayment());
+        assertEquals(1, paid.size());
+        assertEquals(0D, progress.getExperience());
+        verify(mcMMO, never()).notifyJobsXpGain(any());
+    }
+}
