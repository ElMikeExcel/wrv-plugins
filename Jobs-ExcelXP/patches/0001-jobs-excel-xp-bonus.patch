+package com.gamingmesh.jobs.hooks;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import java.util.logging.Logger;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.PluginManager;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.mockito.MockedStatic;
+
+class ExcelXpBonusBridgeTest {
+    public interface ExcelMcMMO extends Plugin {
+        boolean isJobsXpBonusSupported();
+        double getJobsXpBonusMultiplier(Player player);
+        void notifyJobsXpGain(Player player);
+    }
+    public interface WrongReturnMcMMO extends Plugin {
+        boolean isJobsXpBonusSupported();
+        Number getJobsXpBonusMultiplier(Player player);
+        void notifyJobsXpGain(Player player);
+    }
+    public abstract static class StaticApiMcMMO implements Plugin {
+        public static boolean isJobsXpBonusSupported() { return true; }
+        public static double getJobsXpBonusMultiplier(Player player) { return 2D; }
+        public static void notifyJobsXpGain(Player player) { }
+    }
+
+    private MockedStatic<Bukkit> bukkit;
+    private PluginManager plugins;
+    private ExcelMcMMO mcMMO;
+    private Player player;
+
+    @BeforeEach
+    void setUp() {
+        bukkit = mockStatic(Bukkit.class);
+        plugins = mock(PluginManager.class);
+        player = mock(Player.class);
+        mcMMO = mock(ExcelMcMMO.class);
+        bukkit.when(Bukkit::isPrimaryThread).thenReturn(true);
+        bukkit.when(Bukkit::getPluginManager).thenReturn(plugins);
+        when(plugins.getPlugin("mcMMO")).thenReturn(mcMMO);
+        when(mcMMO.isEnabled()).thenReturn(true);
+        when(mcMMO.isJobsXpBonusSupported()).thenReturn(true);
+        when(mcMMO.getJobsXpBonusMultiplier(player)).thenReturn(1.5D);
+        when(mcMMO.getLogger()).thenReturn(Logger.getLogger("ExcelXpBonusBridgeTest"));
+    }
+
+    @AfterEach
+    void tearDown() {
+        bukkit.close();
+    }
+
+    @ParameterizedTest
+    @ValueSource(doubles = {1D, 1.25D, 1.2D, 1.5D})
+    void keepsFractionsForSoloTogetherWeekendAndCombinedFactors(double factor) {
+        when(mcMMO.getJobsXpBonusMultiplier(player)).thenReturn(factor);
+        assertEquals(0.125D * factor, ExcelXpBonusBridge.apply(player, 0.125D), 1e-12);
+    }
+
+    @ParameterizedTest
+    @ValueSource(doubles = {Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, -1D, 0D, 0.5D, Double.MAX_VALUE})
+    void malformedAndOverflowingMultipliersFailClosed(double factor) {
+        when(mcMMO.getJobsXpBonusMultiplier(player)).thenReturn(factor);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+    }
+
+    @ParameterizedTest
+    @ValueSource(doubles = {0D, -1D, Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY})
+    void nonpositiveAndNonfiniteInputIsUntouchedWithoutBridgeCalls(double input) {
+        assertEquals(input, ExcelXpBonusBridge.apply(player, input));
+        verifyNoInteractions(plugins);
+    }
+
+    @Test
+    void optionalPluginMayAppearOrBecomeSupportedLater() {
+        when(plugins.getPlugin("mcMMO")).thenReturn(null);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+        when(plugins.getPlugin("mcMMO")).thenReturn(mcMMO);
+        when(mcMMO.isEnabled()).thenReturn(false);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+        when(mcMMO.isEnabled()).thenReturn(true);
+        when(mcMMO.isJobsXpBonusSupported()).thenReturn(false);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+        when(mcMMO.isJobsXpBonusSupported()).thenReturn(true);
+        assertEquals(15D, ExcelXpBonusBridge.apply(player, 10D));
+    }
+
+    @Test
+    void rejectsUnmodifiedIncompatibleAndStaticApis() {
+        Plugin plain = mock(Plugin.class);
+        when(plain.isEnabled()).thenReturn(true);
+        when(plugins.getPlugin("mcMMO")).thenReturn(plain);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+        WrongReturnMcMMO wrong = mock(WrongReturnMcMMO.class);
+        when(wrong.isEnabled()).thenReturn(true);
+        when(plugins.getPlugin("mcMMO")).thenReturn(wrong);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+        verify(wrong, never()).isJobsXpBonusSupported();
+        StaticApiMcMMO statics = mock(StaticApiMcMMO.class);
+        when(statics.isEnabled()).thenReturn(true);
+        when(plugins.getPlugin("mcMMO")).thenReturn(statics);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+    }
+
+    @Test
+    void doesNotTouchPluginCacheOrApiFromAsyncCallbacks() {
+        bukkit.when(Bukkit::isPrimaryThread).thenReturn(false);
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+        ExcelXpBonusBridge.notifyGain(player, 10D, 1, 0D, 1, 10D);
+        verifyNoInteractions(plugins);
+        verify(mcMMO, never()).getJobsXpBonusMultiplier(player);
+        verify(mcMMO, never()).notifyJobsXpGain(player);
+    }
+
+    @Test
+    void positiveStoredXpOrLevelChangeNotifiesButCapZeroAndLossDoNot() {
+        ExcelXpBonusBridge.notifyGain(player, 10D, 1, 0D, 1, 10D);
+        ExcelXpBonusBridge.notifyGain(player, 10D, 1, 99D, 2, 9D);
+        ExcelXpBonusBridge.notifyGain(player, 10D, 200, 100D, 200, 100D);
+        ExcelXpBonusBridge.notifyGain(player, 0D, 1, 0D, 1, 0D);
+        ExcelXpBonusBridge.notifyGain(player, -10D, 1, 20D, 1, 10D);
+        ExcelXpBonusBridge.notifyGain(player, Double.NaN, 1, 0D, 1, 10D);
+        verify(mcMMO, times(2)).notifyJobsXpGain(player);
+    }
+
+    @Test
+    void exceptionsFailClosedWithoutBreakingAnAward() {
+        when(mcMMO.getJobsXpBonusMultiplier(player)).thenThrow(new IllegalStateException("test"));
+        assertEquals(10D, ExcelXpBonusBridge.apply(player, 10D));
+        doThrow(new IllegalStateException("test")).when(mcMMO).notifyJobsXpGain(player);
+        assertDoesNotThrow(() -> ExcelXpBonusBridge.notifyGain(player, 10D, 1, 0D, 1, 10D));
+    }
+
+    @Test
+    void nullPlayerNeverTouchesTheApi() {
+        assertEquals(10D, ExcelXpBonusBridge.apply(null, 10D));
+        ExcelXpBonusBridge.notifyGain(null, 10D, 1, 0D, 1, 10D);
+        verifyNoInteractions(plugins);
+    }
+}
