+package com.gamingmesh.jobs.hooks;
+
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+
+/**
+ * Optional, lazily discovered bridge to the paired mcMMO Excel XP build.
+ * Does not require either plugin to load first and never changes money or points.
+ */
+public final class ExcelXpBonusBridge {
+    private static Plugin cachedPlugin;
+    private static Method supported;
+    private static Method multiplier;
+    private static Method notifyGain;
+    private static boolean warned;
+
+    private ExcelXpBonusBridge() {
+    }
+
+    private static Plugin findBridge() {
+        Plugin plugin = Bukkit.getPluginManager().getPlugin("mcMMO");
+        if (plugin == null || !plugin.isEnabled())
+            return null;
+
+        if (plugin != cachedPlugin) {
+            cachedPlugin = plugin;
+            supported = null;
+            multiplier = null;
+            notifyGain = null;
+            warned = false;
+            try {
+                Method supportMethod = plugin.getClass().getMethod("isJobsXpBonusSupported");
+                Method multiplierMethod = plugin.getClass().getMethod("getJobsXpBonusMultiplier", Player.class);
+                Method notifyMethod = plugin.getClass().getMethod("notifyJobsXpGain", Player.class);
+                if (!isInstanceMethod(supportMethod, boolean.class)
+                    || !isInstanceMethod(multiplierMethod, double.class)
+                    || !isInstanceMethod(notifyMethod, void.class))
+                    return null;
+                supported = supportMethod;
+                multiplier = multiplierMethod;
+                notifyGain = notifyMethod;
+            } catch (ReflectiveOperationException | LinkageError e) {
+                // Unmodified mcMMO is a supported no-bonus configuration.
+                return null;
+            }
+        }
+        if (supported == null || multiplier == null || notifyGain == null)
+            return null;
+        try {
+            return Boolean.TRUE.equals(supported.invoke(plugin)) ? plugin : null;
+        } catch (ReflectiveOperationException | RuntimeException | LinkageError e) {
+            warn(plugin, e);
+            return null;
+        }
+    }
+
+    private static boolean isInstanceMethod(Method method, Class<?> returnType) {
+        return !Modifier.isStatic(method.getModifiers()) && method.getReturnType() == returnType;
+    }
+
+    /** Applies the current bonus once to positive, finite XP; malformed results fail closed. */
+    public static double apply(Player player, double experience) {
+        if (player == null || !Double.isFinite(experience) || experience <= 0D || !Bukkit.isPrimaryThread())
+            return experience;
+        Plugin plugin = findBridge();
+        if (plugin == null)
+            return experience;
+        try {
+            Object result = multiplier.invoke(plugin, player);
+            double factor = (Double) result;
+            if (!Double.isFinite(factor) || factor < 1D)
+                return experience;
+            double boosted = experience * factor;
+            return Double.isFinite(boosted) ? boosted : experience;
+        } catch (ReflectiveOperationException | RuntimeException | LinkageError e) {
+            warn(plugin, e);
+            return experience;
+        }
+    }
+
+    /** Called only after positive XP really increased stored progression. */
+    public static void notifyGain(Player player, double awardedExperience, int oldLevel,
+        double oldExperience, int newLevel, double newExperience) {
+        if (player == null || !Double.isFinite(awardedExperience) || awardedExperience <= 0D || !Bukkit.isPrimaryThread()
+            || !(newLevel > oldLevel || newLevel == oldLevel && newExperience > oldExperience))
+            return;
+        Plugin plugin = findBridge();
+        if (plugin == null)
+            return;
+        try {
+            notifyGain.invoke(plugin, player);
+        } catch (ReflectiveOperationException | RuntimeException | LinkageError e) {
+            warn(plugin, e);
+        }
+    }
+
+    private static void warn(Plugin plugin, Throwable error) {
+        if (!warned) {
+            warned = true;
+            plugin.getLogger().warning("Jobs Excel XP bridge unavailable; keeping base Jobs XP ("
+                + error.getClass().getSimpleName() + ").");
+        }
+    }
+}
