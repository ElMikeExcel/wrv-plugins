+    String forceCheck(Player p) {
+        Mage mage = api.getController().getRegisteredMage(p);
+        Wand w = mage == null ? null : mage.getActiveWand();
+        if (!isLadderWand(w)) return "not holding a rank wand";
+        RankLadder.Step st = ladder.step(rankOf(w), (long) mage.getCurrency("sp"), stage());
+        if (st != RankLadder.Step.READY) return "step " + st;
+        if (!ownedBy(w, p)) return "not their wand";
+        return rankUp(p, mage, w);
+    }
+
+    void load() {
+        try {
+            if (!dailyFile.isFile()) return;
+            YamlConfiguration y = YamlConfiguration.loadConfiguration(dailyFile);
+            if (!LocalDate.now(CHICAGO).toString().equals(y.getString("date"))) return;
+            ConfigurationSection s = y.getConfigurationSection("earned");
+            if (s != null) for (String k : s.getKeys(false)) today.put(UUID.fromString(k), s.getDouble(k));
+        } catch (Throwable t) { plugin.getLogger().warning("rankup-daily.yml: " + t); }
+    }
+
+    void save() {
+        try {
+            rollDay();
+            YamlConfiguration y = new YamlConfiguration();
+            y.set("date", todayDate.toString());
+            for (Map.Entry<UUID, Double> e : today.entrySet()) y.set("earned." + e.getKey(), Math.round(e.getValue() * 100) / 100.0);
+            y.save(dailyFile);
+        } catch (Throwable t) { plugin.getLogger().warning("rankup-daily.yml: " + t); }
+    }
+
+    @EventHandler
+    public void onQuit(PlayerQuitEvent e) {
+        UUID id = e.getPlayer().getUniqueId();
+        preCast.remove(id);
+        regainAt.remove(id);
+        upgradeFailedAt.remove(id);
+        lastEarn.keySet().removeIf(k -> k.startsWith(id.toString()));
+    }
+
+    private void log(String s) {
+        lastLog = s;
+        if (plugin.debug()) plugin.getLogger().info("rank-up: " + s);
+    }
+}
diff -ruN '--exclude=build' a/src/com/winkreyes/excelwandbars/core/EarnMath.java src/src/com/winkreyes/excelwandbars/core/EarnMath.java
--- a/src/com/winkreyes/excelwandbars/core/EarnMath.java	1969-12-31 18:00:00.000000000 -0600
+++ b/src/com/winkreyes/excelwandbars/core/EarnMath.java	2026-10-26 11:45:07.024315715 -0500
@@ -0,0 +1,73 @@
+package com.winkreyes.excelwandbars.core;
+
+/**
+ * Rank-up by casting (2026-10-26): how many SP one successful cast earns.
+ * Same throttle as Magic's own path earning (BaseSpell: earns scaled by time since the
+ * last paid cast of that spell over earns_cooldown), then the server's XP bonuses
+ * (capped), then a daily soft cap so long grinding sessions slow down.
+ */
+public final class EarnMath {
+    private EarnMath() {}
+
+    /** Magic's formula: floor(earns * min(1, elapsed / cooldown)). cooldown 0 = always full. */
+    public static int throttled(int earns, long elapsedMs, long cooldownMs) {
+        if (earns <= 0) return 0;
+        if (cooldownMs <= 0 || elapsedMs >= cooldownMs) return earns;
+        if (elapsedMs <= 0) return 0;
+        return (int) Math.floor(earns * (double) elapsedMs / (double) cooldownMs);
+    }
+
+    /** The bonus that applies right now. */
+    public static final class Bonus {
+        public final double multiplier;
+        public final String label; // "" when no bonus, else e.g. "weekend + group"
+        Bonus(double m, String l) { multiplier = m; label = l; }
+        public boolean active() { return multiplier > 1.0001; }
+        /** "SP x1.25 (group)" or "" */
+        public String tag() { return active() ? "SP x" + fmt(multiplier) + " (" + label + ")" : ""; }
+    }
+
+    /** Weekend and group bonuses multiply, then the total is capped (cap <= 1 = no bonus at all). */
+    public static Bonus bonus(double weekend, double group, double cap) {
+        double w = weekend > 1.0001 ? weekend : 1.0;
+        double g = group > 1.0001 ? group : 1.0;
+        double m = w * g;
+        if (cap > 0 && m > cap) m = Math.max(1.0, cap);
+        String l = "";
+        if (w > 1.0001 && g > 1.0001) l = "weekend + group";
+        else if (w > 1.0001) l = "weekend";
+        else if (g > 1.0001) l = "group";
+        if (m <= 1.0001) { m = 1.0; l = ""; }
+        return new Bonus(Math.round(m * 1000) / 1000.0, l);
+    }
+
+    /**
+     * Daily soft cap. Up to fullPerDay SP a day earns at full rate, then at slowRate
+     * until maxPerDay, then nothing. 0 = that limit is off. Returns the SP (fractional)
+     * this award may add given what was already earned today.
+     */
+    public static double daily(double award, double earnedToday, double fullPerDay, double maxPerDay, double slowRate) {
+        if (award <= 0) return 0;
+        double out = 0, left = award, at = earnedToday;
+        if (fullPerDay > 0 && at < fullPerDay) {
+            double take = Math.min(left, fullPerDay - at);
+            out += take; left -= take; at += take;
+        } else if (fullPerDay <= 0) {
+            out = award; left = 0; at += award;
+        }
+        if (left > 0) {
+            double slowAward = left * Math.max(0, slowRate);
+            if (maxPerDay > 0) slowAward = Math.min(slowAward, Math.max(0, maxPerDay - at));
+            out += slowAward;
+        }
+        if (maxPerDay > 0 && earnedToday + out > maxPerDay) out = Math.max(0, maxPerDay - earnedToday);
+        return out;
+    }
+
+    public static String fmt(double m) {
+        String s = String.format(java.util.Locale.ROOT, "%.2f", m);
+        while (s.endsWith("0")) s = s.substring(0, s.length() - 1);
+        if (s.endsWith(".")) s = s.substring(0, s.length() - 1);
+        return s;
+    }
+}
diff -ruN '--exclude=build' a/src/com/winkreyes/excelwandbars/core/RankLadder.java src/src/com/winkreyes/excelwandbars/core/RankLadder.java
--- a/src/com/winkreyes/excelwandbars/core/RankLadder.java	1969-12-31 18:00:00.000000000 -0600
+++ b/src/com/winkreyes/excelwandbars/core/RankLadder.java	2026-10-26 11:45:07.024315715 -0500
@@ -0,0 +1,67 @@
+package com.winkreyes.excelwandbars.core;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Rank-up by casting (2026-10-26): the wand rank ladder and the SP each step costs.
+ * Pure (no Bukkit), so the pacing and the text are unit tested.
+ */
+public final class RankLadder {
+    /** Rank key (wand template) in order, lower case. */
+    private final List<String> order = new ArrayList<>();
+    /** SP needed to step UP INTO this rank (the first rank has none). */
+    private final Map<String, Long> cost = new LinkedHashMap<>();
+    /** Optional: lowest seal stage (ExcelMagicGate appliedStage) that opens this rank. Empty = no stage limit. */
+    private final Map<String, Integer> minStage = new LinkedHashMap<>();
+
+    public RankLadder add(String key, long spToReach) {
+        String k = key.toLowerCase(Locale.ROOT);
+        order.add(k);
+        cost.put(k, Math.max(0, spToReach));
+        return this;
+    }
+
+    public RankLadder minStage(String key, int stage) { minStage.put(key.toLowerCase(Locale.ROOT), stage); return this; }
+
+    public static RankLadder wrvDefault() {
+        return new RankLadder().add("beginner", 0).add("student", 800).add("apprentice", 1600).add("master", 1800);
+    }
+
+    public boolean has(String key) { return key != null && order.contains(key.toLowerCase(Locale.ROOT)); }
+    public List<String> order() { return order; }
+
+    /** The rank after this one, or null at the top (or not a ladder wand). */
+    public String next(String key) {
+        if (key == null) return null;
+        int i = order.indexOf(key.toLowerCase(Locale.ROOT));
+        return i < 0 || i + 1 >= order.size() ? null : order.get(i + 1);
+    }
+
+    public long cost(String key) { Long c = key == null ? null : cost.get(key.toLowerCase(Locale.ROOT)); return c == null ? 0 : c; }
+
+    /** Is this rank open at the current seal stage? stage < 0 = unknown, treat as open. */
+    public boolean openAt(String key, int stage) {
+        Integer need = key == null ? null : minStage.get(key.toLowerCase(Locale.ROOT));
+        return need == null || stage < 0 || stage >= need;
+    }
+
+    public enum Step { TOP, NOT_OPEN, SAVING, READY }
+
+    public Step step(String rank, long sp, int stage) {
+        String n = next(rank);
+        if (n == null) return Step.TOP;
+        if (!openAt(n, stage)) return Step.NOT_OPEN;
+        return sp >= cost(n) ? Step.READY : Step.SAVING;
+    }
+
+    /** Total SP from the first rank up to and including this one. */
+    public long total(String key) {
+        long t = 0;
+        for (String k : order) { t += cost(k); if (k.equalsIgnoreCase(key)) return t; }
+        return t;
+    }
+}
diff -ruN '--exclude=build' a/src/com/winkreyes/excelwandbars/core/RankText.java src/src/com/winkreyes/excelwandbars/core/RankText.java
--- a/src/com/winkreyes/excelwandbars/core/RankText.java	1969-12-31 18:00:00.000000000 -0600
+++ b/src/com/winkreyes/excelwandbars/core/RankText.java	2026-10-26 11:45:07.024315715 -0500
@@ -0,0 +1,41 @@
+package com.winkreyes.excelwandbars.core;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Rank-up by casting (2026-10-26): every player-facing line. Short (phones), no em dashes, never mentions seals. */
+public final class RankText {
+    private RankText() {}
+
+    public static String num(long n) { return String.format(java.util.Locale.ROOT, "%,d", n); }
+
+    /** "Student: 340/1,600 SP" or "Master: top rank". */
+    public static String progress(String rankName, long sp, long need, boolean top) {
+        if (top) return rankName + ": top rank";
+        return rankName + ": " + num(Math.min(sp, need)) + "/" + num(need) + " SP";
+    }
+
+    /** Spell Book header lines (both editions). */
+    public static List<String> header(String rankName, String nextName, long sp, long need, RankLadder.Step step, String bonusTag, String howText) {
+        List<String> out = new ArrayList<>();
+        boolean top = step == RankLadder.Step.TOP;
+        out.add(progress(rankName, sp, need, top) + (top || nextName == null ? "" : " to " + nextName));
+        if (step == RankLadder.Step.NOT_OPEN && nextName != null) out.add(nextName + " rank is not open yet.");
+        else if (!top && howText != null && !howText.isBlank()) out.add(howText.trim());
+        if (!top && bonusTag != null && !bonusTag.isBlank()) out.add("Bonus now: " + bonusTag);
+        return out;
+    }
+
+    /** Action bar after a paid cast: "+2 SP (x1.2 weekend) | Student 340/1,600". */
+    public static String earned(int gained, String bonusLabel, double mult, String rankName, long sp, long need, boolean top) {
+        StringBuilder sb = new StringBuilder("+").append(gained).append(" SP");
+        if (mult > 1.0001 && bonusLabel != null && !bonusLabel.isBlank()) sb.append(" (x").append(EarnMath.fmt(mult)).append(' ').append(bonusLabel).append(')');
+        sb.append(" | ").append(top ? rankName + " (top rank)" : rankName + " " + num(Math.min(sp, need)) + "/" + num(need));
+        return sb.toString();
+    }
+
+    public static String fill(String template, String rank, int spells) {
+        if (template == null) return "";
+        return template.replace("{rank}", rank == null ? "" : rank).replace("{spells}", String.valueOf(spells)).replace("\u2014", ",").trim();
+    }
+}
diff -ruN '--exclude=build' a/tests/RankUpTest.java src/tests/RankUpTest.java
--- a/tests/RankUpTest.java	1969-12-31 18:00:00.000000000 -0600
+++ b/tests/RankUpTest.java	2026-10-26 11:46:50.584775113 -0500
@@ -0,0 +1,78 @@
+import com.winkreyes.excelwandbars.core.*;
+
+/** Rank-up by casting (2026-10-26). */
+public final class RankUpTest {
+    public static void run() {
+        System.out.println("RankUpTest");
+        RankLadder l = RankLadder.wrvDefault();
+        Check.eq("student", l.next("beginner"), "next beginner");
+        Check.eq("master", l.next("Apprentice"), "next case-insensitive");
+        Check.eq(null, l.next("master"), "master is top");
+        Check.eq(null, l.next("wand"), "non-ladder wand");
+        Check.eq(800L, l.cost("student"), "student cost");
+        Check.eq(4200L, l.total("master"), "total to master");
+        Check.eq(RankLadder.Step.SAVING, l.step("beginner", 799, 1), "799 saving");
+        Check.eq(RankLadder.Step.READY, l.step("beginner", 800, 1), "800 ready");
+        Check.eq(RankLadder.Step.TOP, l.step("master", 9999, 1), "top");
+        l.minStage("apprentice", 3);
+        Check.eq(RankLadder.Step.NOT_OPEN, l.step("student", 5000, 2), "stage gate closed");
+        Check.eq(RankLadder.Step.READY, l.step("student", 5000, 3), "stage gate open");
+        Check.eq(RankLadder.Step.READY, l.step("student", 5000, -1), "unknown stage = open");
+
+        // Magic's own throttle formula
+        Check.eq(2, EarnMath.throttled(2, 0, 0), "no cooldown full");
+        Check.eq(0, EarnMath.throttled(2, 1000, 60000), "mend spam 1s -> 0");
+        Check.eq(1, EarnMath.throttled(2, 30000, 60000), "half way -> 1");
+        Check.eq(20, EarnMath.throttled(20, 61000, 60000), "full after cooldown");
+        Check.eq(0, EarnMath.throttled(0, 99999, 60000), "earns 0");
+
+        // bonuses
+        Check.eq("", EarnMath.bonus(1, 1, 1.5).tag(), "no bonus");
+        Check.eq("SP x1.2 (weekend)", EarnMath.bonus(1.2, 1, 1.5).tag(), "weekend tag");
+        Check.eq("SP x1.25 (group)", EarnMath.bonus(1, 1.25, 1.5).tag(), "group tag");
+        Check.eq("SP x1.5 (weekend + group)", EarnMath.bonus(1.2, 1.25, 1.5).tag(), "both = cap");
+        Check.eq(1.5, EarnMath.bonus(2.0, 1.25, 1.5).multiplier, "admin xprate 2 capped");
+        Check.eq(1.0, EarnMath.bonus(1.2, 1.25, 1.0).multiplier, "cap 1 = bonuses off");
+        Check.eq(1.0, EarnMath.bonus(0.5, 1, 1.5).multiplier, "never below 1");
+
+        // daily soft cap
+        Check.eq(5.0, EarnMath.daily(5, 0, 800, 1600, 0.25), "under soft cap");
+        Check.eq(3.0 + 0.5, EarnMath.daily(5, 797, 800, 1600, 0.25), "crosses soft cap");
+        Check.eq(1.25, EarnMath.daily(5, 1000, 800, 1600, 0.25), "slow rate");
+        Check.eq(0.0, EarnMath.daily(5, 1600, 800, 1600, 0.25), "hard cap");
+        Check.eq(1.0, EarnMath.daily(8, 1599, 800, 1600, 0.25), "clamped at hard cap");
+        Check.eq(5.0, EarnMath.daily(5, 99999, 0, 0, 0.25), "caps off");
+
+        // text
+        Check.eq("Student: 340/1,600 SP", RankText.progress("Student", 340, 1600, false), "progress");
+        Check.eq("Master: top rank", RankText.progress("Master", 50, 0, true), "top");
+        Check.eq("+2 SP (x1.25 group) | Student 340/1,600", RankText.earned(2, "group", 1.25, "Student", 340, 1600, false), "earned line");
+        Check.eq("+3 SP | Beginner 800/800", RankText.earned(3, "", 1, "Beginner", 900, 800, false), "earned clamps");
+        java.util.List<String> h = RankText.header("Student", "Apprentice", 340, 1600, RankLadder.Step.SAVING, "SP x1.2 (weekend)", "Cast spells to earn SP.");
+        Check.eq("Student: 340/1,600 SP to Apprentice", h.get(0), "header 1");
+        Check.eq("Cast spells to earn SP.", h.get(1), "header 2");
+        Check.eq("Bonus now: SP x1.2 (weekend)", h.get(2), "header 3");
+        h = RankText.header("Student", "Apprentice", 5000, 1600, RankLadder.Step.NOT_OPEN, "", "x");
+        Check.eq("Apprentice rank is not open yet.", h.get(1), "header not open");
+        for (String s : h) Check.ok(s.length() <= SpellInfoText.LINE && !s.contains("\u2014") && !s.toLowerCase().contains("seal"), "line ok: " + s);
+        Check.eq("Student rank! 6 new spells", RankText.fill("{rank} rank! {spells} new spells", "Student", 6), "fill");
+    
+        // 0.2.8 shipped config: on, broadcast on, Master display name, no seal cap, no em dashes, no "seal" in player text
+        try {
+            String cfg = new String(java.nio.file.Files.readAllBytes(java.nio.file.Paths.get("config.yml")), java.nio.charset.StandardCharsets.UTF_8);
+            String sec = cfg.substring(cfg.indexOf("rank-up-casting:"), cfg.indexOf("\nrank-names:"));
+            Check.ok(sec.contains("\n  enabled: true"), "0.2.8 ships rank-up enabled");
+            Check.ok(sec.contains("\n    broadcast: true"), "broadcast on");
+            Check.ok(sec.contains("\n  max-rank-by-stage: {}"), "no seal cap");
+            Check.ok(sec.contains("student: 800") && sec.contains("apprentice: 1600") && sec.contains("master: 1800"), "normal pacing 800/1600/1800");
+            Check.ok(cfg.contains("\n  master: Master\n"), "master shows as Master");
+            Check.ok(!cfg.contains("\u2014"), "no em dash in config");
+            for (String line : sec.split("\n")) {
+                String t = line.trim();
+                if (t.startsWith("title:") || t.startsWith("subtitle:") || t.startsWith("chat:") || t.startsWith("broadcast: \"") || t.startsWith("how:"))
+                    Check.ok(!t.toLowerCase().contains("seal") && t.length() < 120, "player text ok: " + t);
+            }
+        } catch (java.io.IOException e) { Check.ok(false, "read config.yml: " + e); }
+        Check.eq("Pal reached Master rank!", RankText.fill("{player} reached {rank} rank!", "Master", 2).replace("{player}", "Pal"), "broadcast text");
+    }
+}
