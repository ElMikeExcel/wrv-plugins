+                    && isCastOriginName(originName);
+        } catch (Throwable t) {
+            // Same stale-handle discipline as isSummon: drop the handle,
+            // re-resolve next time, pay normally now.
+            summonsGetRecordMethod = null;
+            summonsRecordProbeState = 0;
+            return false;
+        }
+    }
