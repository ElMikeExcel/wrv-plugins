@@ -0,0 +1,47 @@
+package com.winkreyes.excelsummons;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import org.bukkit.entity.Entity;
+
+/**
+ * Test-only stand-in for ExcelSummons' ExcelSummonsAPI, with the same
+ * class name and the same static signatures {@code NoXpEntityRecognition}
+ * resolves reflectively ({@link #isSummon(Entity)} and
+ * {@link #getRecord(Entity)}). Backed by an in-memory registry the tests
+ * seed through {@link #registerForTest(UUID, SummonRecord.Origin)}; with
+ * nothing seeded it answers exactly as an empty live registry would.
+ * Never packaged into the jar.
+ */
+public final class ExcelSummonsAPI {
+
+    private static final Map<UUID, SummonRecord> RECORDS = new HashMap<>();
+
+    private ExcelSummonsAPI() {
+    }
+
+    /** Is this entity a registered summon (any origin)? */
+    public static boolean isSummon(Entity entity) {
+        return entity != null && entity.getUniqueId() != null
+                && RECORDS.containsKey(entity.getUniqueId());
+    }
+
+    /** The registry record for a summon entity, or null. */
+    public static SummonRecord getRecord(Entity entity) {
+        if (entity == null || entity.getUniqueId() == null) {
+            return null;
+        }
+        return RECORDS.get(entity.getUniqueId());
+    }
+
+    /** Test hook: register an entity id with the given origin. */
+    public static void registerForTest(UUID entityId, SummonRecord.Origin origin) {
+        RECORDS.put(entityId, new SummonRecord(origin));
+    }
+
+    /** Test hook: empty the registry between tests. */
+    public static void clearForTest() {
+        RECORDS.clear();
+    }
+}
