+package com.winkreyes.excelsummons;
+
+/**
+ * Test-only stand-in for ExcelSummons' SummonRecord, carrying only the
+ * surface {@code NoXpEntityRecognition} reads reflectively: the nested
+ * {@link Origin} enum and its {@link #origin()} accessor, with the same
+ * shape as the real class (ExcelSummons 0.1.13). It exists so the
+ * origin-aware recognition tests can drive the real reflective path
+ * without a live ExcelSummons plugin; it is never packaged into the jar.
+ */
+public final class SummonRecord {
+
+    public enum Origin {
+        CAST, ADOPTED
+    }
+
+    private final Origin origin;
+
+    public SummonRecord(Origin origin) {
+        this.origin = origin;
+    }
+
+    public Origin origin() {
+        return origin;
+    }
+}
