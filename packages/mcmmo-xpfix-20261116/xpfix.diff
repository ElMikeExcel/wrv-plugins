+package com.gmail.nossr50.util.skills;
+
+import com.gmail.nossr50.config.GeneralConfig;
+import com.gmail.nossr50.mcMMO;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import org.bukkit.World;
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * WRV house patch: recognises the worlds where mcMMO XP never pays — the
+ * EliteMobs worlds (Mike's ruling, Nov 15, 2026: mcMMO XP pays zero in all
+ * EliteMobs worlds; EliteMobs content pays out in its own rewards, Jobs money
+ * and vanilla XP instead).
+ *
+ * <p>mcMMO pays weapon XP per point of damage with no per-entity cap, and
+ * EliteMobs content — today's 83 packages and the gated ExcelExpansions packs
+ * still to release — keeps introducing fresh mega-HP targets. Zeroing gains
+ * by world closes the whole class at once, including every future pack,
+ * because EliteMobs worlds follow a strict naming scheme (verified against
+ * the live server, Nov 15, 2026: every content package's {@code worldName}
+ * across all 83 live package files, the boot log's world-load lines, and the
+ * world names recorded in ExcelProtect's player streams):
+ *
+ * <ul>
+ *   <li>Every EliteMobs world name starts with {@code em_} — the guild hub
+ *       ({@code em_adventurers_guild}), Primis ({@code em_primis}), the
+ *       regional worlds ({@code em_oasis}, {@code em_the_catacombs}, …) and
+ *       the instanced-dungeon bases ({@code em_id_bone_monastery},
+ *       {@code em_id_primis_wolf_den}, …).</li>
+ *   <li>An instanced copy appends {@code _<instance number>} to its base
+ *       world's name ({@code em_id_primis_wolf_den_1},
+ *       {@code em_id_primis_gladius_statue_2}), so the prefix rule covers
+ *       instances with no extra work.</li>
+ *   <li>The one exception in the whole tree is the Goblin Kingdom world,
+ *       {@code GoblinKingdom_vf}, which carries no {@code em_} prefix; it is
+ *       matched by exact name, plus its own would-be instance copies
+ *       ({@code GoblinKingdom_vf_<n>}).</li>
+ * </ul>
+ *
+ * <p>Anything beyond those built-in rules is config, never code: the
+ * {@code WRV.No_XP_Worlds} section of config.yml adds exact world names and
+ * name prefixes (see {@link GeneralConfig#getNoXpWorldNames()}), so a future
+ * pack with an off-pattern world name is a config edit, not a rebuild.
+ *
+ * <p>The fail posture is the mirror of {@link NoXpEntityRecognition}'s: a
+ * world that is NOT positively matched pays normally. The overworld can
+ * therefore never be caught by accident — a broken config read or an
+ * unrecognised name simply leaves gains untouched.
+ */
+public final class NoXpWorldRecognition {
+
+    /** Every EliteMobs base world and instanced copy carries this prefix. */
+    private static final String ELITE_MOBS_WORLD_PREFIX = "em_";
+
+    /** The one live EliteMobs world with no {@code em_} prefix (lowercased). */
+    private static final String GOBLIN_KINGDOM_WORLD_NAME = "goblinkingdom_vf";
+
+    private NoXpWorldRecognition() {
+    }
+
+    /**
+     * Whether the player is standing in a world where mcMMO XP never pays.
+     *
+     * @param player the gaining player, may be null
+     * @return true only when the player's current world is positively
+     *         recognised as an EliteMobs world; false in every other case,
+     *         including a null player or world
+     */
+    public static boolean isNoXpWorld(@Nullable Player player) {
+        if (player == null) {
+            return false;
+        }
+
+        final World world;
+        try {
+            world = player.getWorld();
+        } catch (Throwable t) {
+            return false;
+        }
+
+        return world != null && isNoXpWorldName(world.getName());
+    }
+
+    /**
+     * Whether a world name belongs to an EliteMobs world: the built-in
+     * {@code em_} prefix rule, the Goblin Kingdom exception, or the
+     * admin-configured extra names/prefixes from config.yml.
+     *
+     * @param worldName the Bukkit world name, may be null
+     * @return true only on a positive match; unmatched names pay normally
+     */
+    public static boolean isNoXpWorldName(@Nullable String worldName) {
+        if (worldName == null || worldName.isEmpty()) {
+            return false;
+        }
+
+        final String lower = worldName.toLowerCase(Locale.ROOT);
+
+        if (lower.startsWith(ELITE_MOBS_WORLD_PREFIX)) {
+            return true;
+        }
+
+        // The Goblin Kingdom exception, plus its instanced copies, which
+        // would append "_<instance number>" to the base name exactly as the
+        // em_ instances do.
+        if (lower.equals(GOBLIN_KINGDOM_WORLD_NAME)
+                || lower.startsWith(GOBLIN_KINGDOM_WORLD_NAME + "_")) {
+            return true;
+        }
+
+        return matchesConfiguredExtras(lower);
+    }
+
+    private static boolean matchesConfiguredExtras(String lowerWorldName) {
+        try {
+            if (mcMMO.p == null) {
+                return false;
+            }
+
+            final GeneralConfig config = mcMMO.p.getGeneralConfig();
+            if (config == null) {
+                return false;
+            }
+
+            // Both getters return lowercased values (see GeneralConfig), so
+            // the already-lowercased world name compares directly.
+            final Set<String> names = config.getNoXpWorldNames();
+            if (names != null && names.contains(lowerWorldName)) {
+                return true;
+            }
+
+            final List<String> prefixes = config.getNoXpWorldPrefixes();
+            if (prefixes != null) {
+                for (String prefix : prefixes) {
+                    if (prefix != null && !prefix.isEmpty()
+                            && lowerWorldName.startsWith(prefix)) {
+                        return true;
+                    }
+                }
+            }
+        } catch (Throwable t) {
+            // Config unavailable (early startup, tests): the built-in rules
+            // above have already answered; extras simply do not apply.
+            return false;
+        }
+
+        return false;
+    }
+}
