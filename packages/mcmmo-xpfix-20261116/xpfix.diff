+package com.gmail.nossr50.util.skills;
+
+import static java.util.logging.Logger.getLogger;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.when;
+
+import com.gmail.nossr50.MMOTestEnvironment;
+import com.winkreyes.excelsummons.ExcelSummonsAPI;
+import com.winkreyes.excelsummons.SummonRecord;
+import java.util.UUID;
+import org.bukkit.NamespacedKey;
+import org.bukkit.entity.LivingEntity;
+import org.bukkit.entity.Wolf;
+import org.bukkit.persistence.PersistentDataContainer;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.mockito.Mockito;
+
+class NoXpEntityRecognitionTest extends MMOTestEnvironment {
+    private static final java.util.logging.Logger logger = getLogger(
+            NoXpEntityRecognitionTest.class.getName());
+
+    @BeforeEach
+    void setUp() {
+        mockBaseEnvironment(logger);
+    }
+
+    @AfterEach
+    void tearDown() {
+        cleanUpStaticMocks();
+    }
+
+    @Nested
+    class TrainingDummyFilename {
+
+        @ParameterizedTest
+        @CsvSource({
+                "training_dummy_lv1.yml, true",
+                "training_dummy_lv25.yml, true",
+                "training_dummy_lv100.yml, true",
+                "adventurers_guild/training_dummy_lv50.yml, true",
+                "TRAINING_DUMMY_LV75.YML, true",
+                "damage_test_dummy.yml, true",
+                "adventurers_guild/damage_test_dummy.yml, true",
+                "training_dummy.yml, false",
+                "some_boss.yml, false",
+                "training_dummy_lv100.txt, false",
+        })
+        void filenameShouldMatchOnlyTheGuildTrainingDummySet(String filename,
+                boolean expected) {
+            // When - the filename is checked
+            final boolean recognised =
+                    NoXpEntityRecognition.isTrainingDummyFilename(filename);
+
+            // Then - only the dummy-class boss files match (the guild
+            // training_dummy_lv* set plus EM's damage_test_dummy.yml)
+            assertThat(recognised).isEqualTo(expected);
+        }
+
+        @Test
+        void filenameShouldRejectNull() {
+            assertThat(NoXpEntityRecognition.isTrainingDummyFilename(null))
+                    .isFalse();
+        }
+    }
+
+    @Nested
+    class Stamps {
+
+        private LivingEntity entity;
+        private PersistentDataContainer container;
+
+        @BeforeEach
+        void setUpEntity() {
+            entity = Mockito.mock(LivingEntity.class);
+            container = Mockito.mock(PersistentDataContainer.class);
+            when(entity.getPersistentDataContainer()).thenReturn(container);
+            when(container.has(any(NamespacedKey.class))).thenReturn(false);
+        }
+
+        @Test
+        void excelTrainingDummyStampShouldBeRecognised() {
+            // Given - an entity stamped by ExcelTrainingDummy
+            when(container.has(eq(new NamespacedKey("exceltrainingdummy",
+                    "training")))).thenReturn(true);
+
+            // Then - it is a no-XP entity
+            assertThat(NoXpEntityRecognition.isNoXpEntity(entity)).isTrue();
+        }
+
+        @Test
+        void rewardGuardDeniedStampShouldBeRecognised() {
+            // Given - an entity denied by ExcelRewardGuard
+            when(container.has(eq(new NamespacedKey("excelrewardguard",
+                    "denied_v1")))).thenReturn(true);
+
+            // Then - it is a no-XP entity
+            assertThat(NoXpEntityRecognition.isNoXpEntity(entity)).isTrue();
+        }
+
+        @Test
+        void magicSpawnedStampShouldBeRecognised() {
+            // Given - an entity Magic stamped as spawned
+            when(container.has(eq(new NamespacedKey("magic", "magicspawned"))))
+                    .thenReturn(true);
+
+            // Then - it is a no-XP entity
+            assertThat(NoXpEntityRecognition.isNoXpEntity(entity)).isTrue();
+        }
+
+        @Test
+        void magicMobStampShouldBeRecognised() {
+            // Given - an entity Magic stamped as one of its mobs
+            when(container.has(eq(new NamespacedKey("magic", "magicmob"))))
+                    .thenReturn(true);
+
+            // Then - it is a no-XP entity
+            assertThat(NoXpEntityRecognition.isNoXpEntity(entity)).isTrue();
+        }
+
+        @Test
+        void unstampedEntityShouldNotBeRecognised() {
+            // Given - an ordinary mob with no stamps and no partner plugins
+            // answering for it (control case: a regular mob still pays XP)
+
+            // Then - it is not a no-XP entity
+            assertThat(NoXpEntityRecognition.isNoXpEntity(entity)).isFalse();
+        }
+    }
+
+    @Nested
+    class CastSummonOrigin {
+
+        private Wolf wolf;
+        private UUID wolfId;
+
+        @BeforeEach
+        void setUpWolf() {
+            ExcelSummonsAPI.clearForTest();
+            wolf = Mockito.mock(Wolf.class);
+            wolfId = UUID.randomUUID();
+            when(wolf.getUniqueId()).thenReturn(wolfId);
+        }
+
+        @AfterEach
+        void clearRegistry() {
+            ExcelSummonsAPI.clearForTest();
+        }
+
+        private void enableSummonsPlugin() {
+            Plugin summonsPlugin = Mockito.mock(Plugin.class);
+            when(summonsPlugin.isEnabled()).thenReturn(true);
+            when(pluginManager.getPlugin("ExcelSummons"))
+                    .thenReturn(summonsPlugin);
+        }
+
+        @Test
+        void castSummonWolfShouldEarnNoTamingXp() {
+            // Given - a wolf ExcelSummons registered as CAST (a Magic cast
+            // conjured it); CombatUtils pays the owner's Taming award
+            // exactly when isCastSummon answers false
+            enableSummonsPlugin();
+            ExcelSummonsAPI.registerForTest(wolfId, SummonRecord.Origin.CAST);
+
+            // Then - it is a registered summon AND positively cast-made,
+            // so the pet branch skips the award: the owner earns 0
+            assertThat(NoXpEntityRecognition.isSummon(wolf)).isTrue();
+            assertThat(NoXpEntityRecognition.isCastSummon(wolf)).isTrue();
+        }
+
+        @Test
+        void adoptedPetWolfShouldStillEarnTamingXp() {
+            // Given - a hand-tamed wolf ExcelSummons' sweep registered as
+            // ADOPTED (the player's own pet dog)
+            enableSummonsPlugin();
+            ExcelSummonsAPI.registerForTest(wolfId,
+                    SummonRecord.Origin.ADOPTED);
+
+            // Then - registry membership alone no longer blocks the award:
+            // it is a summon, but not a cast summon, so the owner still pays
+            assertThat(NoXpEntityRecognition.isSummon(wolf)).isTrue();
+            assertThat(NoXpEntityRecognition.isCastSummon(wolf)).isFalse();
+        }
+
+        @Test
+        void unregisteredWolfShouldStillEarnTamingXp() {
+            // Given - an ordinary tamed wolf ExcelSummons has no record of
+            enableSummonsPlugin();
+
+            // Then - nothing positively identifies it as cast-made: it pays
+            assertThat(NoXpEntityRecognition.isSummon(wolf)).isFalse();
+            assertThat(NoXpEntityRecognition.isCastSummon(wolf)).isFalse();
+        }
+
+        @Test
+        void castCheckShouldFailOpenWhenPluginAbsent() {
+            // Given - a CAST record exists in the registry, but the
+            // ExcelSummons plugin itself is absent (the plugin manager
+            // answers null, as in the base environment)
+            ExcelSummonsAPI.registerForTest(wolfId, SummonRecord.Origin.CAST);
+
+            // Then - the check cannot positively identify anything: it pays
+            assertThat(NoXpEntityRecognition.isCastSummon(wolf)).isFalse();
+        }
+
+        @ParameterizedTest
+        @CsvSource({
+                "CAST, true",
+                "ADOPTED, false",
+                "cast, false",
+                "UNKNOWN, false",
+        })
+        void originNameShouldMatchOnlyExactCast(String originName,
+                boolean expected) {
+            assertThat(NoXpEntityRecognition.isCastOriginName(originName))
+                    .isEqualTo(expected);
+        }
+
+        @Test
+        void originNameShouldRejectNull() {
+            assertThat(NoXpEntityRecognition.isCastOriginName(null)).isFalse();
+        }
+    }
+
+    @Nested
+    class NullSafety {
+
+        @Test
+        void nullEntityShouldNotBeRecognised() {
+            assertThat(NoXpEntityRecognition.isNoXpEntity(null)).isFalse();
+            assertThat(NoXpEntityRecognition.isSummon(null)).isFalse();
+            assertThat(NoXpEntityRecognition.isCastSummon(null)).isFalse();
+        }
+    }
+}
