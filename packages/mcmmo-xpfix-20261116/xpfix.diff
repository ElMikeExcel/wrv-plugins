+package com.gmail.nossr50.datatypes.player;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.gmail.nossr50.MMOTestEnvironment;
+import com.gmail.nossr50.config.experience.ExperienceConfig;
+import com.gmail.nossr50.datatypes.experience.FormulaType;
+import com.gmail.nossr50.datatypes.experience.XPGainReason;
+import com.gmail.nossr50.datatypes.experience.XPGainSource;
+import com.gmail.nossr50.datatypes.party.Party;
+import com.gmail.nossr50.datatypes.party.ShareMode;
+import com.gmail.nossr50.datatypes.skills.PrimarySkillType;
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.party.PartyManager;
+import com.gmail.nossr50.util.Permissions;
+import com.gmail.nossr50.util.TestPlayerMock;
+import com.gmail.nossr50.util.experience.FormulaManager;
+import java.util.List;
+import java.util.logging.Logger;
+import org.bukkit.World;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Covers Mike's ruling (Nov 15, 2026) at the pipeline level: a player standing
+ * in an EliteMobs world gains no mcMMO XP through any channel — the normal
+ * gain pipeline, the exact-amount funnel, or a party XP share — while the
+ * same gains in the overworld pay exactly as before.
+ */
+class McMMOPlayerNoXpWorldTest extends MMOTestEnvironment {
+    private static final Logger logger = Logger.getLogger(
+            McMMOPlayerNoXpWorldTest.class.getName());
+    private static final int XP_TO_NEXT_LEVEL = 10;
+
+    @BeforeEach
+    void setUp() {
+        mockBaseEnvironment(logger);
+        stubLevelUpEnvironment();
+    }
+
+    @AfterEach
+    void tearDown() {
+        cleanUpStaticMocks();
+    }
+
+    /**
+     * Stubs everything the gain path needs so gains translate into level-ups:
+     * skill permissions, disabled level caps, a 1.0 rate, and a flat XP curve.
+     * Mirrors {@code McMMOPlayerAddXpAndLevelsTest}.
+     */
+    private void stubLevelUpEnvironment() {
+        when(Permissions.skillEnabled(any(Player.class), any(PrimarySkillType.class)))
+                .thenReturn(true);
+        when(generalConfig.getPowerLevelCap()).thenReturn(Integer.MAX_VALUE);
+        when(generalConfig.getLevelCap(any(PrimarySkillType.class)))
+                .thenReturn(Integer.MAX_VALUE);
+        when(ExperienceConfig.getInstance().getFormulaType()).thenReturn(FormulaType.LINEAR);
+        when(experienceConfigInstance.getExperienceGainsMultiplier(
+                any(PrimarySkillType.class))).thenReturn(1D);
+
+        final FormulaManager formulaManager = mock(FormulaManager.class);
+        when(formulaManager.getXPtoNextLevel(anyInt(), any(FormulaType.class)))
+                .thenReturn(XP_TO_NEXT_LEVEL);
+        when(mcMMO.getFormulaManager()).thenReturn(formulaManager);
+    }
+
+    private void useWorld(String worldName) {
+        final World bukkitWorld = mock(World.class);
+        when(bukkitWorld.getName()).thenReturn(worldName);
+        when(player.getWorld()).thenReturn(bukkitWorld);
+    }
+
+    private float rawXp(PrimarySkillType skill) {
+        return mmoPlayer.getProfile().getSkillXpLevelRaw(skill);
+    }
+
+    @Nested
+    class GainPipeline {
+
+        @Test
+        void beginXpGainShouldAwardNothingAcrossChannelsInEliteMobsWorld() {
+            // Given - the player is standing in the Adventurers Guild hub
+            useWorld("em_adventurers_guild");
+
+            // When - gains arrive through the normal pipeline for a combat
+            // skill, a gathering skill, Acrobatics, and Taming
+            mmoPlayer.beginXpGain(PrimarySkillType.SWORDS, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+            mmoPlayer.beginXpGain(PrimarySkillType.MINING, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+            mmoPlayer.beginXpGain(PrimarySkillType.ACROBATICS, 5F,
+                    XPGainReason.PVE, XPGainSource.SELF);
+            mmoPlayer.beginXpGain(PrimarySkillType.TAMING, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - no channel paid anything
+            assertThat(rawXp(PrimarySkillType.SWORDS)).isZero();
+            assertThat(rawXp(PrimarySkillType.MINING)).isZero();
+            assertThat(rawXp(PrimarySkillType.ACROBATICS)).isZero();
+            assertThat(rawXp(PrimarySkillType.TAMING)).isZero();
+        }
+
+        @Test
+        void beginXpGainShouldAwardNothingInInstancedDungeonCopy() {
+            // Given - the player is inside an instanced Primis dungeon copy
+            useWorld("em_id_primis_wolf_den_1");
+
+            // When - a combat gain arrives
+            mmoPlayer.beginXpGain(PrimarySkillType.SWORDS, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - the instanced copy is an EliteMobs world too
+            assertThat(rawXp(PrimarySkillType.SWORDS)).isZero();
+        }
+
+        @Test
+        void beginXpGainShouldAwardNormallyInOverworld() {
+            // Given - the player is standing in the overworld
+            useWorld("world");
+
+            // When - combat and gathering gains arrive
+            mmoPlayer.beginXpGain(PrimarySkillType.SWORDS, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+            mmoPlayer.beginXpGain(PrimarySkillType.MINING, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - both pay the full amount, as before the ruling
+            assertThat(rawXp(PrimarySkillType.SWORDS)).isEqualTo(5F);
+            assertThat(rawXp(PrimarySkillType.MINING)).isEqualTo(5F);
+        }
+    }
+
+    @Nested
+    class ExactAmountFunnel {
+
+        @Test
+        void applyXpGainShouldAwardNothingInEliteMobsWorld() {
+            // Given - the player is standing in Primis
+            useWorld("em_primis");
+
+            // When - an exact-amount gain arrives through the funnel the API
+            // and /addxp paths use (it bypasses beginXpGain entirely)
+            mmoPlayer.applyXpGain(PrimarySkillType.MINING, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - the funnel pays nothing in an EliteMobs world
+            assertThat(rawXp(PrimarySkillType.MINING)).isZero();
+            assertThat(mmoPlayer.getSkillLevel(PrimarySkillType.MINING)).isZero();
+        }
+
+        @Test
+        void applyXpGainShouldAwardNormallyInOverworld() {
+            // Given - the player is standing in the overworld
+            useWorld("world");
+
+            // When - an exact-amount gain arrives through the funnel
+            mmoPlayer.applyXpGain(PrimarySkillType.MINING, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - it accrues exactly, as before the ruling
+            assertThat(rawXp(PrimarySkillType.MINING)).isEqualTo(5F);
+        }
+    }
+
+    @Nested
+    class PartyShare {
+
+        private TestPlayerMock member;
+
+        private void stubEqualSharePartyWithMemberIn(String memberWorldName) {
+            member = mockPlayer();
+            final World memberWorld = mock(World.class);
+            when(memberWorld.getName()).thenReturn(memberWorldName);
+            when(member.player().getWorld()).thenReturn(memberWorld);
+
+            final Party party = mock(Party.class);
+            when(party.getXpShareMode()).thenReturn(ShareMode.EQUAL);
+            mmoPlayer.setParty(party);
+
+            final PartyManager partyManager = mock(PartyManager.class);
+            when(mcMMO.p.getPartyManager()).thenReturn(partyManager);
+            // ShareHandler adds the earner to the returned list, so it must
+            // be mutable (the real PartyManager returns an ArrayList)
+            when(partyManager.getNearVisibleMembers(mmoPlayer))
+                    .thenReturn(new java.util.ArrayList<>(List.of(member.player())));
+
+            // Share bonus of exactly 1.0: a 100 XP gain splits 50 / 50
+            when(generalConfig.getPartyShareBonusBase()).thenReturn(1.0D);
+            when(generalConfig.getPartyShareBonusIncrease()).thenReturn(0.0D);
+            when(generalConfig.getPartyShareBonusCap()).thenReturn(10.0D);
+        }
+
+        @Test
+        void shareShouldNotReachMemberStandingInEliteMobsWorld() {
+            // Given - the earner is in the overworld, the party member is
+            // standing in Primis, and XP sharing is EQUAL
+            useWorld("world");
+            stubEqualSharePartyWithMemberIn("em_primis");
+
+            // When - the earner gains 100 Swords XP
+            mmoPlayer.beginXpGain(PrimarySkillType.SWORDS, 100F,
+                    XPGainReason.PVE, XPGainSource.SELF);
+
+            // Then - the earner keeps their own 50 XP share (5 levels on the
+            // flat 10-XP curve)...
+            assertThat(mmoPlayer.getSkillLevel(PrimarySkillType.SWORDS))
+                    .isEqualTo(5);
+            assertThat(rawXp(PrimarySkillType.SWORDS)).isZero();
+
+            // ...but the member in the EliteMobs world receives nothing
+            assertThat(member.mmoPlayer().getSkillLevel(PrimarySkillType.SWORDS))
+                    .isZero();
+            assertThat(member.playerProfile()
+                    .getSkillXpLevelRaw(PrimarySkillType.SWORDS)).isZero();
+        }
+
+        @Test
+        void shareShouldReachMemberStandingInOverworld() {
+            // Given - both players are in the overworld, sharing EQUAL
+            useWorld("world");
+            stubEqualSharePartyWithMemberIn("world");
+
+            // When - the earner gains 100 Swords XP
+            mmoPlayer.beginXpGain(PrimarySkillType.SWORDS, 100F,
+                    XPGainReason.PVE, XPGainSource.SELF);
+
+            // Then - the control case: the member's 50 XP share pays in full
+            assertThat(member.mmoPlayer().getSkillLevel(PrimarySkillType.SWORDS))
+                    .isEqualTo(5);
+            assertThat(member.playerProfile()
