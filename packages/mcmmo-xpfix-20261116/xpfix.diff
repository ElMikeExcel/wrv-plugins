+package com.gmail.nossr50.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Answers.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.mock;
+
+import com.gmail.nossr50.MMOTestEnvironment;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.lang.reflect.Field;
+import java.nio.charset.StandardCharsets;
+import java.util.logging.Logger;
+import org.bukkit.Material;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Guards the WRV no-XP worlds config contract: the shipped config.yml carries
+ * the {@code WRV.No_XP_Worlds} keys, and the getters resolve them lowercased
+ * and blank-free so {@code NoXpWorldRecognition} can compare a lowercased
+ * world name directly. Follows the {@code GeneralConfigTogetherBonusTest}
+ * pattern.
+ */
+class GeneralConfigNoXpWorldsTest extends MMOTestEnvironment {
+    private static final Logger logger =
+            Logger.getLogger(GeneralConfigNoXpWorldsTest.class.getName());
+
+    @BeforeEach
+    void setUp() {
+        mockBaseEnvironment(logger);
+    }
+
+    @AfterEach
+    void tearDown() {
+        cleanUpStaticMocks();
+    }
+
+    /**
+     * Creates a {@link GeneralConfig} whose backing config is the given YAML,
+     * without running the file-loading constructor. {@code loadKeys} cannot
+     * run on the mock (its inline-initialized maps stay null), so the two
+     * memoized anvil materials it would resolve are injected directly; the
+     * no-XP getters resolve lazily from the backing config and need no such
+     * injection.
+     */
+    private static GeneralConfig generalConfigBackedBy(final YamlConfiguration yaml) {
+        final GeneralConfig generalConfig = mock(GeneralConfig.class, CALLS_REAL_METHODS);
+        try {
+            final Field configField = BukkitConfig.class.getDeclaredField("config");
+            configField.setAccessible(true);
+            configField.set(generalConfig, yaml);
+            setMemoizedMaterial(generalConfig, "repairAnvilMaterial", Material.IRON_BLOCK);
+            setMemoizedMaterial(generalConfig, "salvageAnvilMaterial", Material.GOLD_BLOCK);
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("Unable to inject backing config", e);
+        }
+        return generalConfig;
+    }
+
+    private static void setMemoizedMaterial(final GeneralConfig generalConfig,
+            final String fieldName, final Material material)
+            throws ReflectiveOperationException {
+        final Field field = GeneralConfig.class.getDeclaredField(fieldName);
+        field.setAccessible(true);
+        field.set(generalConfig, material);
+    }
+
+    /** Loads the config.yml bundled with the plugin jar. */
+    private static YamlConfiguration shippedConfigYaml() {
+        final InputStream resource =
+                GeneralConfig.class.getClassLoader().getResourceAsStream("config.yml");
+        assertThat(resource).as("bundled config.yml resource").isNotNull();
+        return YamlConfiguration.loadConfiguration(
+                new InputStreamReader(resource, StandardCharsets.UTF_8));
+    }
+
+    @Test
+    void shippedConfigShouldCarryEmptyNoXpWorldExtrasAndValidate() {
+        // Given - the config.yml shipped with the plugin, with no admin edits
+        final YamlConfiguration shippedYaml = shippedConfigYaml();
+        final GeneralConfig generalConfig = generalConfigBackedBy(shippedYaml);
+
+        // Then - the shipped file defines the keys the getters read
+        assertThat(shippedYaml.isSet("WRV.No_XP_Worlds.Extra_Names")).isTrue();
+        assertThat(shippedYaml.isSet("WRV.No_XP_Worlds.Extra_Prefixes")).isTrue();
+
+        // And - the shipped defaults are empty: the built-in rules alone apply
+        assertThat(generalConfig.getNoXpWorldNames()).isEmpty();
+        assertThat(generalConfig.getNoXpWorldPrefixes()).isEmpty();
+
+        // And - the shipped file still passes validation with the WRV section
+        assertThat(generalConfig.validateKeys()).isTrue();
+    }
+
+    @Test
+    void gettersShouldResolveConfiguredExtrasLowercasedAndBlankFree() {
+        // Given - an admin config with mixed case, stray spaces, and blanks
+        final YamlConfiguration yaml = new YamlConfiguration();
+        yaml.set("WRV.No_XP_Worlds.Extra_Names",
+                java.util.List.of("Future_Pack_World", "  spaced_name  ", ""));
+        yaml.set("WRV.No_XP_Worlds.Extra_Prefixes",
+                java.util.List.of("TD_", " "));
+        final GeneralConfig generalConfig = generalConfigBackedBy(yaml);
+
+        // Then - the getters hand back comparison-ready values
+        assertThat(generalConfig.getNoXpWorldNames())
+                .containsExactlyInAnyOrder("future_pack_world", "spaced_name");
+        assertThat(generalConfig.getNoXpWorldPrefixes())
+                .containsExactly("td_");
+    }
+
+    @Test
+    void gettersShouldReturnEmptyWhenSectionIsAbsent() {
+        // Given - a config with no WRV section at all (getter fallbacks apply)
+        final GeneralConfig generalConfig =
+                generalConfigBackedBy(new YamlConfiguration());
+
+        // Then - the extras are empty, never null
+        assertThat(generalConfig.getNoXpWorldNames()).isEmpty();
+        assertThat(generalConfig.getNoXpWorldPrefixes()).isEmpty();
+    }
+}
