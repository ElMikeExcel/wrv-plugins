+
+/**
+ * Covers Mike's ruling (Nov 15, 2026) at the pipeline level: a player standing
+ * in an EliteMobs world gains no mcMMO XP through any channel — the normal
+ * gain pipeline, the exact-amount funnel, or a party XP share — while the
+ * same gains in the overworld pay exactly as before.
+ */
+class McMMOPlayerNoXpWorldTest extends MMOTestEnvironment {
+    private static final Logger logger = Logger.getLogger(
+            McMMOPlayerNoXpWorldTest.class.getName());
+    private static final int XP_TO_NEXT_LEVEL = 10;
+
+    @BeforeEach
+    void setUp() {
+        mockBaseEnvironment(logger);
+        stubLevelUpEnvironment();
+    }
+
+    @AfterEach
+    void tearDown() {
+        cleanUpStaticMocks();
+    }
+
+    /**
+     * Stubs everything the gain path needs so gains translate into level-ups:
+     * skill permissions, disabled level caps, a 1.0 rate, and a flat XP curve.
+     * Mirrors {@code McMMOPlayerAddXpAndLevelsTest}.
+     */
+    private void stubLevelUpEnvironment() {
+        when(Permissions.skillEnabled(any(Player.class), any(PrimarySkillType.class)))
+                .thenReturn(true);
+        when(generalConfig.getPowerLevelCap()).thenReturn(Integer.MAX_VALUE);
+        when(generalConfig.getLevelCap(any(PrimarySkillType.class)))
+                .thenReturn(Integer.MAX_VALUE);
+        when(ExperienceConfig.getInstance().getFormulaType()).thenReturn(FormulaType.LINEAR);
+        when(experienceConfigInstance.getExperienceGainsMultiplier(
+                any(PrimarySkillType.class))).thenReturn(1D);
+
+        final FormulaManager formulaManager = mock(FormulaManager.class);
+        when(formulaManager.getXPtoNextLevel(anyInt(), any(FormulaType.class)))
+                .thenReturn(XP_TO_NEXT_LEVEL);
+        when(mcMMO.getFormulaManager()).thenReturn(formulaManager);
+    }
+
+    private void useWorld(String worldName) {
+        final World bukkitWorld = mock(World.class);
+        when(bukkitWorld.getName()).thenReturn(worldName);
+        when(player.getWorld()).thenReturn(bukkitWorld);
+    }
+
+    private float rawXp(PrimarySkillType skill) {
+        return mmoPlayer.getProfile().getSkillXpLevelRaw(skill);
+    }
+
+    @Nested
+    class GainPipeline {
+
+        @Test
+        void beginXpGainShouldAwardNothingAcrossChannelsInEliteMobsWorld() {
+            // Given - the player is standing in the Adventurers Guild hub
+            useWorld("em_adventurers_guild");
+
+            // When - gains arrive through the normal pipeline for a combat
+            // skill, a gathering skill, Acrobatics, and Taming
+            mmoPlayer.beginXpGain(PrimarySkillType.SWORDS, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+            mmoPlayer.beginXpGain(PrimarySkillType.MINING, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+            mmoPlayer.beginXpGain(PrimarySkillType.ACROBATICS, 5F,
+                    XPGainReason.PVE, XPGainSource.SELF);
+            mmoPlayer.beginXpGain(PrimarySkillType.TAMING, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - no channel paid anything
+            assertThat(rawXp(PrimarySkillType.SWORDS)).isZero();
+            assertThat(rawXp(PrimarySkillType.MINING)).isZero();
+            assertThat(rawXp(PrimarySkillType.ACROBATICS)).isZero();
+            assertThat(rawXp(PrimarySkillType.TAMING)).isZero();
+        }
+
+        @Test
+        void beginXpGainShouldAwardNothingInInstancedDungeonCopy() {
+            // Given - the player is inside an instanced Primis dungeon copy
+            useWorld("em_id_primis_wolf_den_1");
+
+            // When - a combat gain arrives
+            mmoPlayer.beginXpGain(PrimarySkillType.SWORDS, 5F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - the instanced copy is an EliteMobs world too
