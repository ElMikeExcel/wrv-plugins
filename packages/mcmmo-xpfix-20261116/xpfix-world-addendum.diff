+package com.gmail.nossr50.util.skills;
+
+import static java.util.logging.Logger.getLogger;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.gmail.nossr50.MMOTestEnvironment;
+import java.util.List;
+import java.util.Set;
+import org.bukkit.World;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+
+class NoXpWorldRecognitionTest extends MMOTestEnvironment {
+    private static final java.util.logging.Logger logger = getLogger(
+            NoXpWorldRecognitionTest.class.getName());
+
+    @BeforeEach
+    void setUp() {
+        mockBaseEnvironment(logger);
+    }
+
+    @AfterEach
+    void tearDown() {
+        cleanUpStaticMocks();
+    }
+
+    @Nested
+    class BuiltInRules {
+
+        @ParameterizedTest
+        @CsvSource({
+                // EliteMobs base worlds (live census, Nov 15, 2026)
+                "em_adventurers_guild, true",
+                "em_primis, true",
+                "em_primis_elementals_arena, true",
+                "em_oasis, true",
+                "em_the_catacombs, true",
+                "em_id_bone_monastery, true",
+                "em_id_enchantment_challenge_20, true",
+                // Instanced copies: base name + _<instance number>
+                "em_id_primis_wolf_den_1, true",
+                "em_id_primis_lighthouse_keeper_1, true",
+                "em_id_primis_gladius_statue_2, true",
+                // Case does not matter
+                "EM_PRIMIS, true",
+                "Em_Id_Primis_Wolf_Den_1, true",
+                // The one non-em_ EliteMobs world, and its instance copies
+                "GoblinKingdom_vf, true",
+                "goblinkingdom_vf, true",
+                "GoblinKingdom_vf_1, true",
+                // Everything else pays normally
+                "world, false",
+                "world_nether, false",
+                "world_the_end, false",
+                "em, false",
+                "emx_world, false",
+                "some_em_world, false",
+                "goblinkingdom, false",
+                "goblinkingdom_vfx, false",
+        })
+        void worldNameShouldMatchOnlyEliteMobsWorlds(String worldName,
+                boolean expected) {
+            // When - the world name is checked against the built-in rules
+            final boolean recognised =
+                    NoXpWorldRecognition.isNoXpWorldName(worldName);
+
+            // Then - only EliteMobs worlds are recognised
+            assertThat(recognised).isEqualTo(expected);
+        }
+
+        @Test
+        void worldNameShouldRejectNullAndEmpty() {
+            assertThat(NoXpWorldRecognition.isNoXpWorldName(null)).isFalse();
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("")).isFalse();
+        }
+    }
+
+    @Nested
+    class ConfiguredExtras {
+
+        @Test
+        void extraNameFromConfigShouldBeRecognised() {
+            // Given - an admin added an off-pattern world name to config.yml
+            // (the getters return lowercased values; see GeneralConfig)
+            when(generalConfig.getNoXpWorldNames())
+                    .thenReturn(Set.of("future_pack_world"));
+            when(generalConfig.getNoXpWorldPrefixes()).thenReturn(List.of());
+
+            // Then - that world pays no XP, in any case
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("future_pack_world"))
+                    .isTrue();
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("Future_Pack_World"))
+                    .isTrue();
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("future_pack_world_2"))
+                    .isFalse();
+        }
+
+        @Test
+        void extraPrefixFromConfigShouldBeRecognised() {
+            // Given - an admin added a world-name prefix to config.yml
+            when(generalConfig.getNoXpWorldNames()).thenReturn(Set.of());
+            when(generalConfig.getNoXpWorldPrefixes()).thenReturn(List.of("td_"));
+
+            // Then - the whole family matches, instances included
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("td_hub")).isTrue();
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("td_hub_3")).isTrue();
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("atd_hub")).isFalse();
+        }
+
+        @Test
+        void builtInRulesShouldWorkWhenConfigExtrasAreUnavailable() {
+            // Given - the config getters answer null (Mockito default), which
+            // the recognition must treat as "no extras", never as an error
+            // Then - the built-in rules still answer on their own
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("em_primis"))
+                    .isTrue();
+            assertThat(NoXpWorldRecognition.isNoXpWorldName("world")).isFalse();
+        }
+    }
+
+    @Nested
+    class PlayerPredicate {
+
+        @Test
+        void playerInEliteMobsWorldShouldBeRecognised() {
+            // Given - a player standing in the guild hub
+            final Player bukkitPlayer = mock(Player.class);
+            final World bukkitWorld = mock(World.class);
+            when(bukkitWorld.getName()).thenReturn("em_adventurers_guild");
