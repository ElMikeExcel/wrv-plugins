+    /** Display duration after the latest gain; invalid values use the three-second default. */
+    public long getXpBonusIndicatorDisplayTicks() {
+        final double seconds = config.getDouble("General.XP_Bonus_Indicator.Display_Seconds", 3.0D);
+        return Double.isFinite(seconds) && seconds >= 0.1D && seconds <= 60.0D
+                ? Math.max(1L, Math.round(seconds * 20.0D)) : 60L;
+    }
