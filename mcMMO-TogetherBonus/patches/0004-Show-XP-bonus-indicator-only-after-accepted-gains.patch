+    /** Observe only eligible gameplay pickups; the indicator reads the final amount next tick. */
+    @EventHandler(priority = EventPriority.MONITOR)
+    public void onPlayerExpChangeMonitor(PlayerExpChangeEvent event) {
+        if (plugin.getXpBonusIndicator() != null && vanillaXpBonus.isSupported()
+                && ListenerGuards.resolveEligiblePlayer(event.getPlayer()) != null
+                && event.getPlayer().getGameMode() != GameMode.CREATIVE
+                && event.getPlayer().getGameMode() != GameMode.SPECTATOR
