@@ -0,0 +1,52 @@
+package com.gmail.nossr50.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Answers.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.mock;
+
+import java.io.InputStreamReader;
+import java.lang.reflect.Field;
+import java.nio.charset.StandardCharsets;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.junit.jupiter.params.provider.ValueSource;
+
+class XpBonusIndicatorConfigTest {
+    private GeneralConfig config(YamlConfiguration yaml) throws Exception {
+        GeneralConfig config = mock(GeneralConfig.class, CALLS_REAL_METHODS);
+        Field field = BukkitConfig.class.getDeclaredField("config");
+        field.setAccessible(true);
+        field.set(config, yaml);
+        return config;
+    }
+
+    @Test
+    void oldConfigWithoutDurationAndShippedConfigShouldDefaultToThreeSeconds() throws Exception {
+        assertThat(config(new YamlConfiguration()).getXpBonusIndicatorDisplayTicks()).isEqualTo(60L);
+        var resource = GeneralConfig.class.getClassLoader().getResourceAsStream("config.yml");
+        assertThat(resource).isNotNull();
+        try (var reader = new InputStreamReader(resource, StandardCharsets.UTF_8)) {
+            var yaml = YamlConfiguration.loadConfiguration(reader);
+            assertThat(yaml.getDouble("General.XP_Bonus_Indicator.Display_Seconds")).isEqualTo(3.0D);
+            assertThat(config(yaml).getXpBonusIndicatorDisplayTicks()).isEqualTo(60L);
+        }
+    }
+
+    @ParameterizedTest
+    @CsvSource({"0.1, 2", "0.5, 10", "1.25, 25", "3, 60", "60, 1200"})
+    void supportedDurationsShouldConvertToTicks(double seconds, long ticks) throws Exception {
+        var yaml = new YamlConfiguration();
+        yaml.set("General.XP_Bonus_Indicator.Display_Seconds", seconds);
+        assertThat(config(yaml).getXpBonusIndicatorDisplayTicks()).isEqualTo(ticks);
+    }
+
+    @ParameterizedTest
+    @ValueSource(doubles = {-1, 0, 0.01, 61, Double.NaN, Double.POSITIVE_INFINITY})
+    void invalidDurationsShouldFailToShortDefault(double seconds) throws Exception {
+        var yaml = new YamlConfiguration();
+        yaml.set("General.XP_Bonus_Indicator.Display_Seconds", seconds);
+        assertThat(config(yaml).getXpBonusIndicatorDisplayTicks()).isEqualTo(60L);
+    }
+}
