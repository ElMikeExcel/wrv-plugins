+package com.gmail.nossr50.party;
+
+import static java.util.Objects.requireNonNull;
+
+import com.gmail.nossr50.config.GeneralConfig;
+import com.gmail.nossr50.datatypes.experience.XPGainSource;
+import com.gmail.nossr50.datatypes.party.Party;
+import com.gmail.nossr50.datatypes.player.McMMOPlayer;
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.util.Misc;
+import com.gmail.nossr50.util.Permissions;
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * The party Together bonus: extra skill XP while enough other party members are close by.
+ * <p>
+ * The bonus is decided once, for the player who earned the XP, before any party XP share. It
+ * only boosts skill XP; party leveling XP is never boosted.
+ */
+public final class PartyTogetherBonus {
+    /** Multiplier for gains that do not qualify for the bonus. */
+    public static final float NO_BONUS = 1.0F;
+
+    private PartyTogetherBonus() {
+    }
+
+    /**
+     * Get the skill XP multiplier for a gain earned by this player.
+     * <p>
+     * Only gameplay gains ({@link XPGainSource#SELF} and {@link XPGainSource#PASSIVE}) qualify, so
+     * XP from commands, other plugins, vampirism or party share is never boosted.
+     *
+     * @param mmoPlayer The player who earned the XP
+     * @param xpGainSource Where the XP came from
+     * @return the configured multiplier if the bonus applies, otherwise {@link #NO_BONUS}
+     */
+    public static float getSkillXpMultiplier(@NotNull McMMOPlayer mmoPlayer,
+            @NotNull XPGainSource xpGainSource) {
+        final boolean gameplayGain = switch (xpGainSource) {
+            case SELF, PASSIVE -> true;
+            default -> false;
+        };
+
+        return gameplayGain && isActive(mmoPlayer)
+                ? (float) mcMMO.p.getGeneralConfig().getPartyTogetherBonusMultiplier()
+                : NO_BONUS;
+    }
+
+    /**
+     * Check whether the bonus applies to this player right now: the feature is enabled, the
+     * player has the perk, and enough other online party members are close by in the same world.
+     *
+     * @param mmoPlayer The player to check
+     * @return true if the player's gameplay XP is currently boosted
+     */
+    public static boolean isActive(@NotNull McMMOPlayer mmoPlayer) {
+        requireNonNull(mmoPlayer, "mmoPlayer cannot be null!");
+        final Party party = mmoPlayer.getParty();
+        final GeneralConfig generalConfig = mcMMO.p.getGeneralConfig();
+
+        if (party == null || !mcMMO.p.getPartyConfig().isPartyEnabled()
+                || !generalConfig.isPartyTogetherBonusEnabled()) {
+            return false;
+        }
+
+        final Player player = mmoPlayer.getPlayer();
+
+        if (!Permissions.hasPartyTogetherBonusPerk(player)) {
+            return false;
+        }
+
+        final int needed = generalConfig.getPartyTogetherBonusMinNearbyMembers();
+        final double range = generalConfig.getPartyTogetherBonusRange();
+        int nearby = 0;
+
+        // Count without building a list since this runs on every XP gain
+        for (Player member : party.getOnlineMembers()) {
+            if (!player.equals(member) && member.isValid()
+                    && Misc.isNear(player.getLocation(), member.getLocation(), range)
+                    && ++nearby >= needed) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
