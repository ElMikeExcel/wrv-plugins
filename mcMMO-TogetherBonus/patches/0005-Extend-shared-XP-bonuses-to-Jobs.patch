--- /dev/null
+++ b/src/test/java/com/gmail/nossr50/party/JobsXpBonusTest.java
@@ -0,0 +1,155 @@
+package com.gmail.nossr50.party;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+import com.gmail.nossr50.MMOTestEnvironment;
+import com.gmail.nossr50.listeners.ListenerGuards;
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.util.PaperUtil;
+import com.gmail.nossr50.util.experience.XpBonusIndicator;
+import java.util.logging.Logger;
+import org.bukkit.Bukkit;
+import org.bukkit.GameMode;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.mockito.MockedStatic;
+
+class JobsXpBonusTest extends MMOTestEnvironment {
+    public interface PatchedJobs extends Plugin {
+        boolean isExcelXpBonusSupported();
+    }
+
+    private MockedStatic<PaperUtil> paper;
+    private MockedStatic<ListenerGuards> guards;
+    private MockedStatic<PartyTogetherBonus> together;
+    private JobsXpBonus bonus;
+    private PatchedJobs jobs;
+    private XpBonusIndicator indicator;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        mockBaseEnvironment(Logger.getLogger(getClass().getName()));
+        paper = mockStatic(PaperUtil.class);
+        guards = mockStatic(ListenerGuards.class);
+        together = mockStatic(PartyTogetherBonus.class);
+        when(Bukkit.isPrimaryThread()).thenReturn(true);
+        when(player.isOnline()).thenReturn(true);
+        when(player.getGameMode()).thenReturn(GameMode.SURVIVAL);
+        when(ListenerGuards.resolveEligiblePlayer(player)).thenReturn(mmoPlayer);
+        when(ListenerGuards.canGainGameplayXp(player)).thenReturn(true);
+        when(generalConfig.getPartyTogetherBonusMultiplier()).thenReturn(1.25D);
+        when(mcMMO.p.getVanillaXpEventMultiplier()).thenReturn(1.0D);
+        jobs = mock(PatchedJobs.class);
+        when(jobs.isEnabled()).thenReturn(true);
+        when(jobs.isExcelXpBonusSupported()).thenReturn(true);
+        when(pluginManager.getPlugin("Jobs")).thenReturn(jobs);
+        indicator = mock(XpBonusIndicator.class);
+        when(mcMMO.p.getXpBonusIndicator()).thenReturn(indicator);
+        bonus = new JobsXpBonus(mcMMO.p);
+    }
+
+    @AfterEach
+    void tearDown() {
+        together.close();
+        guards.close();
+        paper.close();
+        cleanUpStaticMocks();
+    }
+
+    @ParameterizedTest
+    @CsvSource({"false,1.0,1.0", "true,1.0,1.25", "false,1.2,1.2", "true,1.2,1.5"})
+    void usesExistingTogetherAndWeekendSourceOfTruth(boolean active, double weekend, double expected) {
+        when(PartyTogetherBonus.isActive(mmoPlayer)).thenReturn(active);
+        when(mcMMO.p.getVanillaXpEventMultiplier()).thenReturn(weekend);
+        assertThat(bonus.multiplier(player)).isEqualTo(expected);
+        // A factor lookup never awards XP or displays a notification.
+        verifyNoInteractions(indicator);
+    }
+
+    @Test
+    void missingDisabledAndUnpatchedJobsFailClosed() {
+        when(pluginManager.getPlugin("Jobs")).thenReturn(null);
+        assertThat(bonus.isSupported()).isFalse();
+        assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+        Plugin unpatched = mock(Plugin.class);
+        when(unpatched.isEnabled()).thenReturn(true);
+        when(pluginManager.getPlugin("Jobs")).thenReturn(unpatched);
+        assertThat(bonus.isSupported()).isFalse();
+        when(pluginManager.getPlugin("Jobs")).thenReturn(jobs);
+        when(jobs.isEnabled()).thenReturn(false);
+        assertThat(bonus.isSupported()).isFalse();
+        bonus.notifyGain(player);
+        verifyNoInteractions(indicator);
+    }
+
+    @Test
+    void replacementPluginAndCapabilityFailuresDoNotReuseStaleSupport() {
+        assertThat(bonus.isSupported()).isTrue();
+        PatchedJobs replacement = mock(PatchedJobs.class);
+        when(replacement.isEnabled()).thenReturn(true);
+        when(pluginManager.getPlugin("Jobs")).thenReturn(replacement);
+        assertThat(bonus.isSupported()).isFalse();
+        when(replacement.isExcelXpBonusSupported()).thenThrow(new IllegalStateException("broken"));
+        assertThat(bonus.isSupported()).isFalse();
+        when(pluginManager.getPlugin("Jobs")).thenReturn(jobs);
+        assertThat(bonus.isSupported()).isTrue();
+    }
+
+    @Test
+    void actualAcceptedGainUsesExistingTemporaryIndicator() {
+        bonus.notifyGain(player);
+        verify(indicator).onXpGain(player);
+        when(mcMMO.p.getXpBonusIndicator()).thenReturn(null);
+        bonus.notifyGain(player);
+    }
+
+    @Test
+    void foliaAndAsyncCallsNeverQueryPartyOrDisplay() {
+        when(Bukkit.isPrimaryThread()).thenReturn(false);
+        assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+        bonus.notifyGain(player);
+        when(Bukkit.isPrimaryThread()).thenReturn(true);
+        when(PaperUtil.isFolia()).thenReturn(true);
+        assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+        bonus.notifyGain(player);
+        together.verifyNoInteractions();
+        guards.verifyNoInteractions();
+        verifyNoInteractions(indicator);
+    }
+
+    @Test
+    void profileWorldGameplayAndModeGatesAreHonored() {
+        when(PartyTogetherBonus.isActive(mmoPlayer)).thenReturn(true);
+        for (GameMode mode : new GameMode[] {GameMode.CREATIVE, GameMode.SPECTATOR}) {
+            when(player.getGameMode()).thenReturn(mode);
+            assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+            bonus.notifyGain(player);
+        }
+        when(player.getGameMode()).thenReturn(GameMode.SURVIVAL);
+        when(ListenerGuards.canGainGameplayXp(player)).thenReturn(false);
+        assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+        bonus.notifyGain(player);
+        when(ListenerGuards.canGainGameplayXp(player)).thenReturn(true);
+        when(ListenerGuards.resolveEligiblePlayer(player)).thenReturn(null);
+        assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+        bonus.notifyGain(player);
+        verifyNoInteractions(indicator);
+    }
+
+    @Test
+    void invalidAndOverflowFactorsFailClosed() {
+        when(PartyTogetherBonus.isActive(mmoPlayer)).thenReturn(true);
+        for (double invalid : new double[] {Double.NaN, Double.POSITIVE_INFINITY, -1.0D, 0.0D}) {
+            when(generalConfig.getPartyTogetherBonusMultiplier()).thenReturn(invalid);
+            assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+        }
+        when(generalConfig.getPartyTogetherBonusMultiplier()).thenReturn(Double.MAX_VALUE);
+        when(mcMMO.p.getVanillaXpEventMultiplier()).thenReturn(2.0D);
+        assertThat(bonus.multiplier(player)).isEqualTo(1.0D);
+    }
+}
