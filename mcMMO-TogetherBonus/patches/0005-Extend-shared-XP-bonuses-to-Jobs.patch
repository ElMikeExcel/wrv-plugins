@@ -0,0 +1,79 @@
+package com.gmail.nossr50.party;
+
+import com.gmail.nossr50.datatypes.player.McMMOPlayer;
+import com.gmail.nossr50.listeners.ListenerGuards;
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.util.PaperUtil;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import org.bukkit.Bukkit;
+import org.bukkit.GameMode;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.Plugin;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/** Shared rules for the optional, capability-checked Jobs post-event award bridge. */
+public final class JobsXpBonus {
+    private final mcMMO plugin;
+    private @Nullable Plugin jobs;
+    private @Nullable Method capability;
+
+    public JobsXpBonus(@NotNull mcMMO plugin) {
+        this.plugin = plugin;
+    }
+
+    /** Never claim support for an unpatched Jobs whose fast-payment path ignores XP events. */
+    public boolean isSupported() {
+        if (PaperUtil.isFolia()) {
+            return false;
+        }
+        final Plugin current = plugin.getServer().getPluginManager().getPlugin("Jobs");
+        if (current == null || !current.isEnabled()) {
+            return false;
+        }
+        try {
+            if (jobs != current || capability == null) {
+                final Method method = current.getClass().getMethod("isExcelXpBonusSupported");
+                if (method.getReturnType() != boolean.class || Modifier.isStatic(method.getModifiers())) {
+                    return false;
+                }
+                jobs = current;
+                capability = method;
+            }
+            return Boolean.TRUE.equals(capability.invoke(current));
+        } catch (ReflectiveOperationException | RuntimeException | LinkageError exception) {
+            return false;
+        }
+    }
+
+    /** Checks the same loaded-profile, world and party rules as the existing award channels. */
+    private @Nullable McMMOPlayer eligible(@NotNull Player player) {
+        // Proximity reads are synchronous. Never schedule a delayed bonus against a stale action.
+        if (!Bukkit.isPrimaryThread() || !isSupported() || !player.isOnline()
+                || player.getGameMode() == GameMode.CREATIVE || player.getGameMode() == GameMode.SPECTATOR) {
+            return null;
+        }
+        final McMMOPlayer mmoPlayer = ListenerGuards.resolveEligiblePlayer(player);
+        return mmoPlayer != null && ListenerGuards.canGainGameplayXp(player) ? mmoPlayer : null;
+    }
+
+    /** Jobs applies this once after its own formulas/events; no economy or progression mutation here. */
+    public double multiplier(@NotNull Player player) {
+        final McMMOPlayer mmoPlayer = eligible(player);
+        if (mmoPlayer == null) {
+            return 1.0D;
+        }
+        final double together = PartyTogetherBonus.isActive(mmoPlayer)
+                ? plugin.getGeneralConfig().getPartyTogetherBonusMultiplier() : 1.0D;
+        final double multiplier = plugin.getVanillaXpEventMultiplier() * together;
+        return Double.isFinite(multiplier) && multiplier >= 1.0D ? multiplier : 1.0D;
+    }
+
+    /** Jobs calls only after a positive award actually increased job XP or job level. */
+    public void notifyGain(@NotNull Player player) {
+        if (eligible(player) != null && plugin.getXpBonusIndicator() != null) {
+            plugin.getXpBonusIndicator().onXpGain(player);
+        }
+    }
+}
