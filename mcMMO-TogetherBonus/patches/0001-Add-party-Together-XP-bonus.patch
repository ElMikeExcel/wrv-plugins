+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import com.gmail.nossr50.MMOTestEnvironment;
+import com.gmail.nossr50.datatypes.experience.XPGainReason;
+import com.gmail.nossr50.datatypes.experience.XPGainSource;
+import com.gmail.nossr50.datatypes.party.Party;
+import com.gmail.nossr50.datatypes.party.ShareMode;
+import com.gmail.nossr50.datatypes.player.McMMOPlayer;
+import com.gmail.nossr50.datatypes.skills.PrimarySkillType;
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.util.Misc;
+import com.gmail.nossr50.util.Permissions;
+import com.gmail.nossr50.util.TestPlayerMock;
+import java.util.logging.Logger;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Covers the party Together bonus: extra skill XP while other party members are close by.
+ */
+class PartyTogetherBonusTest extends MMOTestEnvironment {
+    private static final Logger logger = Logger.getLogger(PartyTogetherBonusTest.class.getName());
+    private static final double RANGE = 32.0D;
+    private static final double MULTIPLIER = 1.25D;
+
+    private PartyManager partyManager;
+    private Party party;
+    private Player member;
+    private McMMOPlayer memberMmoPlayer;
+
+    @BeforeEach
+    void setUp() {
+        mockBaseEnvironment(logger);
+
+        // Given - parties on, Together bonus enabled with defaults, everyone holding the perk
+        when(partyConfig.isPartyEnabled()).thenReturn(true);
+        when(generalConfig.isPartyTogetherBonusEnabled()).thenReturn(true);
+        when(generalConfig.getPartyTogetherBonusMultiplier()).thenReturn(MULTIPLIER);
+        when(generalConfig.getPartyTogetherBonusRange()).thenReturn(RANGE);
+        when(generalConfig.getPartyTogetherBonusMinNearbyMembers()).thenReturn(1);
+        when(Permissions.hasPartyTogetherBonusPerk(any(Player.class))).thenReturn(true);
+        mockedMisc.when(() -> Misc.isNear(any(Location.class), any(Location.class), anyDouble()))
+                .thenCallRealMethod();
+
+        partyManager = new PartyManager(mcMMO.p);
+        when(mcMMO.p.getPartyManager()).thenReturn(partyManager);
+
+        final TestPlayerMock memberMock = mockPlayer();
+        member = memberMock.player();
+        memberMmoPlayer = memberMock.mmoPlayer();
+
+        party = new Party("Family");
+        party.getOnlineMembers().add(player);
+        party.getOnlineMembers().add(member);
+        mmoPlayer.setParty(party);
+        memberMmoPlayer.setParty(party);
+
+        when(player.getLocation()).thenReturn(new Location(world, 0, 64, 0));
+        placeMember(world, 10);
+    }
+
+    @AfterEach
+    void tearDown() {
+        cleanUpStaticMocks();
+        when(partyConfig.isPartyEnabled()).thenReturn(false);
+    }
+
+    private void placeMember(World memberWorld, double x) {
+        when(member.getLocation()).thenReturn(new Location(memberWorld, x, 64, 0));
+    }
+
+    @Nested
+    class IsTogetherBonusActive {
+        @Test
+        void bonusShouldApplyWhenAPartyMemberIsInRange() {
+            // Given - a party member 10 blocks away (setUp)
+
+            // When / Then
+            assertThat(partyManager.isTogetherBonusActive(mmoPlayer)).isTrue();
+        }
+
+        @Test
+        void bonusShouldNotApplyWhenDisabledInConfig() {
+            // Given - the feature is turned off
+            when(generalConfig.isPartyTogetherBonusEnabled()).thenReturn(false);
+
+            // When / Then
+            assertThat(partyManager.isTogetherBonusActive(mmoPlayer)).isFalse();
+        }
+
+        @Test
+        void bonusShouldNotApplyWhenTheMemberIsOutOfRange() {
+            // Given - the only other member is farther away than the range
+            placeMember(world, RANGE + 1);
+
+            // When / Then
+            assertThat(partyManager.isTogetherBonusActive(mmoPlayer)).isFalse();
+        }
+
+        @Test
+        void bonusShouldNotApplyWhenTheMemberIsInAnotherWorld() {
+            // Given - same coordinates, but in the Nether
+            placeMember(mock(World.class), 0);
+
+            // When / Then
+            assertThat(partyManager.isTogetherBonusActive(mmoPlayer)).isFalse();
+        }
+
+        @Test
+        void bonusShouldNotApplyWithoutThePermission() {
+            // Given - the earning player lacks mcmmo.perks.partybonus
+            when(Permissions.hasPartyTogetherBonusPerk(player)).thenReturn(false);
+
+            // When / Then
+            assertThat(partyManager.isTogetherBonusActive(mmoPlayer)).isFalse();
+        }
+
+        @Test
+        void bonusShouldNotApplyWhenFewerMembersThanRequiredAreNearby() {
+            // Given - two nearby members are required but only one is close
+            when(generalConfig.getPartyTogetherBonusMinNearbyMembers()).thenReturn(2);
+
+            // When / Then
+            assertThat(partyManager.isTogetherBonusActive(mmoPlayer)).isFalse();
+        }
+    }
+
+    @Nested
+    class XpGain {
+        @Test
+        void beginXpGainShouldMultiplyTheGainWhenTheBonusIsActive() {
+            // Given - a member nearby and no XP share (setUp)
+
+            // When
+            mmoPlayer.beginXpGain(PrimarySkillType.MINING, 10F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - the gain is boosted by the multiplier
+            verify(mmoPlayer).beginUnsharedXpGain(PrimarySkillType.MINING, 12.5F,
+                    XPGainReason.PVE, XPGainSource.SELF);
+        }
+
+        @Test
+        void beginXpGainShouldNotMultiplyTheGainWhenTheBonusIsDisabled() {
+            // Given
+            when(generalConfig.isPartyTogetherBonusEnabled()).thenReturn(false);
+
+            // When
+            mmoPlayer.beginXpGain(PrimarySkillType.MINING, 10F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then
+            verify(mmoPlayer).beginUnsharedXpGain(PrimarySkillType.MINING, 10F,
+                    XPGainReason.PVE, XPGainSource.SELF);
+        }
+
+        @Test
+        void sharedXpShouldBeBoostedOnceAndNotAgainForReceivingMembers() {
+            // Given - equal XP share with a neutral share bonus, so each player gets half
+            party.setXpShareMode(ShareMode.EQUAL);
+            when(player.canSee(member)).thenReturn(true);
+            when(generalConfig.getPartyShareRange()).thenReturn(75.0D);
+            when(generalConfig.getPartyShareBonusBase()).thenReturn(1.0D);
+            when(generalConfig.getPartyShareBonusIncrease()).thenReturn(0.0D);
+            when(generalConfig.getPartyShareBonusCap()).thenReturn(1.0D);
+
+            // When
+            mmoPlayer.beginXpGain(PrimarySkillType.MINING, 10F, XPGainReason.PVE,
+                    XPGainSource.SELF);
+
+            // Then - 10 XP boosted to 12.5 and split in two; the member is not boosted again
+            verify(mmoPlayer).beginUnsharedXpGain(eq(PrimarySkillType.MINING), eq(6.25F),
+                    any(XPGainReason.class), eq(XPGainSource.PARTY_MEMBERS));
+            verify(memberMmoPlayer).beginUnsharedXpGain(eq(PrimarySkillType.MINING), eq(6.25F),
+                    any(XPGainReason.class), eq(XPGainSource.PARTY_MEMBERS));
+            verify(memberMmoPlayer, never()).beginXpGain(any(PrimarySkillType.class), anyFloat(),
+                    any(XPGainReason.class), any(XPGainSource.class));
+        }
+    }
+}
