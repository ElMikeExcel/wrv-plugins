+    /**
+     * Check whether the party Together bonus applies to this player right now: the feature is
+     * enabled, the player has the perk, and enough other online party members are close by in
+     * the same world.
+     *
+     * @param mmoPlayer The player earning XP
+     * @return true if the player's XP gains should be multiplied by the Together bonus
+     */
+    public boolean isTogetherBonusActive(@NotNull McMMOPlayer mmoPlayer) {
+        requireNonNull(mmoPlayer, "mmoPlayer cannot be null!");
+        final GeneralConfig generalConfig = pluginRef.getGeneralConfig();
+        final Party party = mmoPlayer.getParty();
+
+        if (party == null || !pluginRef.getPartyConfig().isPartyEnabled()
+                || !generalConfig.isPartyTogetherBonusEnabled()) {
+            return false;
+        }
+
+        final Player player = mmoPlayer.getPlayer();
+
+        if (!Permissions.hasPartyTogetherBonusPerk(player)) {
+            return false;
+        }
+
+        final int needed = generalConfig.getPartyTogetherBonusMinNearbyMembers();
+        final double range = generalConfig.getPartyTogetherBonusRange();
+        int nearby = 0;
+
+        // Count without building a list since this runs on every XP gain
+        for (Player member : party.getOnlineMembers()) {
+            if (!player.equals(member) && member.isValid()
+                    && Misc.isNear(player.getLocation(), member.getLocation(), range)
+                    && ++nearby >= needed) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
