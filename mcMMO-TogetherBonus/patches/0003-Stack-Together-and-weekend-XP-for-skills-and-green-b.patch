diff --git a/src/main/java/com/gmail/nossr50/party/VanillaXpBonus.java b/src/main/java/com/gmail/nossr50/party/VanillaXpBonus.java
new file mode 100644
index 0000000..d990f5b
--- /dev/null
+++ b/src/main/java/com/gmail/nossr50/party/VanillaXpBonus.java
@@ -0,0 +1,142 @@
+package com.gmail.nossr50.party;
+
+import com.gmail.nossr50.datatypes.player.McMMOPlayer;
+import com.gmail.nossr50.mcMMO;
+import java.lang.reflect.Method;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.bukkit.GameMode;
+import org.bukkit.NamespacedKey;
+import org.bukkit.entity.ExperienceOrb;
+import org.bukkit.entity.Player;
+import org.bukkit.event.player.PlayerExpChangeEvent;
+import org.bukkit.persistence.PersistentDataContainer;
+import org.bukkit.persistence.PersistentDataType;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * One green-bar award pipeline for the weekend event and Together bonus. Modifies the existing
+ * post-Mending pickup event once; never creates an orb or calls giveExp, so bonuses cannot recurse.
+ * Paper source APIs are optional to retain the mcMMO build's Spigot compatibility.
+ */
+public final class VanillaXpBonus {
+    private static final NamespacedKey REMAINDER_KEY =
+            NamespacedKey.fromString("mcmmo:vanilla_bonus_remainder");
+    private static final NamespacedKey GAMEPLAY_ORB_KEY =
+            NamespacedKey.fromString("mcmmo:gameplay_xp_orb");
+    private static final Set<String> GAMEPLAY_REASONS = Set.of(
+            "ENTITY_DEATH", "FURNACE", "BREED", "VILLAGER_TRADE", "FISHING", "BLOCK_BREAK",
+            "EXP_BOTTLE", "GRINDSTONE");
+
+    private final mcMMO plugin;
+    private final @Nullable Method sourceGetter;
+    private final @Nullable Method reasonGetter;
+    private final boolean supported;
+    private final AtomicBoolean reflectionFailureReported = new AtomicBoolean();
+
+    public VanillaXpBonus(@NotNull mcMMO plugin) {
+        this(plugin, findMethod(PlayerExpChangeEvent.class, "getSource"),
+                findMethod(ExperienceOrb.class, "getSpawnReason"), isFolia()
+                        || !mcMMO.getMinecraftGameVersion().isAtLeast(1, 21, 8));
+        if (!supported) {
+            plugin.getLogger().warning("Vanilla XP bonuses are unavailable: Paper orb-source APIs "
+                    + "and non-Folia Paper 1.21.8+ are required. mcMMO skill bonuses remain available.");
+        }
+    }
+
+    // Method injection keeps the optional Paper bridge testable against the Spigot compile API.
+    VanillaXpBonus(mcMMO plugin, @Nullable Method sourceGetter, @Nullable Method reasonGetter,
+            boolean folia) {
+        this.plugin = plugin;
+        this.sourceGetter = sourceGetter;
+        this.reasonGetter = reasonGetter;
+        supported = sourceGetter != null && reasonGetter != null && !folia;
+    }
+
+    public boolean isSupported() {
+        return supported && !reflectionFailureReported.get();
+    }
+
+    /**
+     * Boosts only eligible positive gameplay pickups. Both factors are combined before rounding;
+     * a player's fractional bonus is persisted independently of their current level/progress bar.
+     * Ineligible awards leave previously earned fractions untouched.
+     */
+    public void apply(@NotNull PlayerExpChangeEvent event, @NotNull McMMOPlayer mmoPlayer) {
+        final Player player = event.getPlayer();
+        final int amount = event.getAmount();
+        if (!isSupported() || amount <= 0 || player.getGameMode() == GameMode.CREATIVE
+                || player.getGameMode() == GameMode.SPECTATOR) {
+            return;
+        }
+
+        final double eventMultiplier = plugin.getVanillaXpEventMultiplier();
+        final double togetherMultiplier = PartyTogetherBonus.isActive(mmoPlayer)
+                ? plugin.getGeneralConfig().getPartyTogetherBonusMultiplier() : 1.0D;
+        final double multiplier = eventMultiplier * togetherMultiplier;
+        if (!Double.isFinite(multiplier) || multiplier <= 1.0D || !isGameplayPickup(event)) {
+            return;
+        }
+
+        final PersistentDataContainer data = player.getPersistentDataContainer();
+        final Double storedRemainder = data.get(REMAINDER_KEY, PersistentDataType.DOUBLE);
+        final double remainder = storedRemainder != null && Double.isFinite(storedRemainder)
+                && storedRemainder >= 0.0D && storedRemainder < 1.0D ? storedRemainder : 0.0D;
+        final double bonus = amount * (multiplier - 1.0D) + remainder;
+        final int headroom = Integer.MAX_VALUE - amount;
+        // Saturate rather than wrapping negative. Do not bank an unbounded overflow payout.
+        final int wholeBonus = (int) Math.min(headroom, Math.floor(bonus + 1.0E-9D));
+        final double nextRemainder = bonus >= headroom ? 0.0D : Math.max(0.0D, bonus - wholeBonus);
+        data.set(REMAINDER_KEY, PersistentDataType.DOUBLE, nextRemainder);
+        event.setAmount(amount + wholeBonus);
+    }
+
+    /** Marks orbs produced by mcMMO gameplay; arbitrary plugin-created XP stays excluded. */
+    public static void markGameplayOrb(@NotNull ExperienceOrb orb) {
+        orb.getPersistentDataContainer().set(GAMEPLAY_ORB_KEY, PersistentDataType.BYTE, (byte) 1);
+    }
+
+    boolean isGameplayPickup(PlayerExpChangeEvent event) {
+        if (!isSupported()) {
+            return false;
+        }
+        try {
+            if (!(sourceGetter.invoke(event) instanceof ExperienceOrb orb)) {
+                return false;
+            }
+            final Object reason = reasonGetter.invoke(orb);
+            // Fail closed for missing or unrecognized reasons, death refunds, and external grants.
+            if (!(reason instanceof Enum<?> spawnReason)) {
+                return false;
+            }
+            return GAMEPLAY_REASONS.contains(spawnReason.name())
+                    || ((spawnReason.name().equals("CUSTOM") || spawnReason.name().equals("UNKNOWN"))
+                    && orb.getPersistentDataContainer().has(GAMEPLAY_ORB_KEY, PersistentDataType.BYTE));
+        } catch (ReflectiveOperationException | RuntimeException exception) {
+            if (reflectionFailureReported.compareAndSet(false, true)) {
+                plugin.getLogger().warning("Vanilla XP bonuses disabled because Paper orb-source "
+                        + "inspection failed: " + exception.getClass().getSimpleName());
+            }
+            return false;
+        }
+    }
+
+    private static @Nullable Method findMethod(Class<?> type, String name) {
+        try {
+            return type.getMethod(name);
+        } catch (NoSuchMethodException exception) {
+            return null;
+        }
+    }
+
+    private static boolean isFolia() {
+        try {
+            Class.forName("io.papermc.paper.threadedregions.RegionizedServer", false,
+                    VanillaXpBonus.class.getClassLoader());
+            return true;
+        } catch (ClassNotFoundException exception) {
+            return false;
+        }
+    }
+}
