diff --git a/src/main/java/com/gmail/nossr50/util/experience/XpBonusIndicator.java b/src/main/java/com/gmail/nossr50/util/experience/XpBonusIndicator.java
new file mode 100644
index 0000000..42d75f1
--- /dev/null
+++ b/src/main/java/com/gmail/nossr50/util/experience/XpBonusIndicator.java
@@ -0,0 +1,123 @@
+package com.gmail.nossr50.util.experience;
+
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.util.PaperUtil;
+import com.tcoded.folialib.wrapper.task.WrappedTask;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import org.bukkit.Bukkit;
+import org.bukkit.NamespacedKey;
+import org.bukkit.boss.BarColor;
+import org.bukkit.boss.BarStyle;
+import org.bukkit.boss.BossBar;
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.Listener;
+import org.bukkit.event.player.PlayerChangedWorldEvent;
+import org.bukkit.event.player.PlayerQuitEvent;
+import org.bukkit.persistence.PersistentDataType;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/** Owns only the persistent XP-bonus indicator; ordinary skill progress bars remain independent. */
+public final class XpBonusIndicator implements Listener {
+    private static final NamespacedKey HIDDEN_KEY = NamespacedKey.fromString("mcmmo:xp_bonus_indicator_hidden");
+    private static final long REFRESH_TICKS = 20L;
+
+    private final mcMMO plugin;
+    private final Map<UUID, Entry> bars = new ConcurrentHashMap<>();
+    private @Nullable WrappedTask refreshTask;
+
+    private record Entry(@NotNull BossBar bar, @NotNull String title) {
+    }
+
+    public XpBonusIndicator(@NotNull mcMMO plugin) {
+        this.plugin = plugin;
+    }
+
+    /** Starts a single lightweight main-thread refresh on Bukkit/Paper. Folia fails closed. */
+    public void start() {
+        if (refreshTask != null || !plugin.getGeneralConfig().isXpBonusIndicatorEnabled()) {
+            return;
+        }
+        if (PaperUtil.isFolia()) {
+            plugin.getLogger().warning("Live XP bonus indicator is unavailable on Folia because "
+                    + "party proximity queries are not region-safe.");
+            return;
+        }
+        refreshTask = plugin.getFoliaLib().getScheduler().runTimer(this::refreshAll, REFRESH_TICKS, REFRESH_TICKS);
+    }
+
+    private void refreshAll() {
+        for (final Player player : plugin.getServer().getOnlinePlayers()) {
+            refresh(player);
+        }
+    }
+
+    /** Defaults to shown; only an explicit per-player hide preference is persisted. */
+    public boolean isVisible(@NotNull Player player) {
+        return !Byte.valueOf((byte) 1).equals(player.getPersistentDataContainer()
+                .get(HIDDEN_KEY, PersistentDataType.BYTE));
+    }
+
+    /** Persists the player's preference and immediately reflects it in this indicator only. */
+    public void setVisible(@NotNull Player player, boolean visible) {
+        if (visible) {
+            player.getPersistentDataContainer().remove(HIDDEN_KEY);
+        } else {
+            player.getPersistentDataContainer().set(HIDDEN_KEY, PersistentDataType.BYTE, (byte) 1);
+        }
+        refresh(player);
+    }
+
+    /** Refreshes after commands; the regular one-second refresh also picks up movement and party changes. */
+    public void refresh(@NotNull Player player) {
+        if (PaperUtil.isFolia() || !plugin.getGeneralConfig().isXpBonusIndicatorEnabled()
+                || !player.isOnline() || !isVisible(player)) {
+            remove(player.getUniqueId());
+            return;
+        }
+        final String title = XpBonusStatus.capture(plugin, player).title();
+        final UUID id = player.getUniqueId();
+        final Entry existing = bars.get(id);
+        if (existing == null) {
+            final BossBar bar = Bukkit.createBossBar(title, BarColor.GREEN, BarStyle.SOLID);
+            bar.setProgress(1.0D);
+            bar.addPlayer(player);
+            bars.put(id, new Entry(bar, title));
+        } else if (!existing.title().equals(title)) {
+            existing.bar().setTitle(title);
+            bars.put(id, new Entry(existing.bar(), title));
+        }
+    }
+
+    /** Immediately drops the previous world's factors, including blacklist and region gates. */
+    @EventHandler
+    public void onWorldChange(@NotNull PlayerChangedWorldEvent event) {
+        refresh(event.getPlayer());
+    }
+
+    /** Removes references promptly rather than waiting for the next timer tick. */
+    @EventHandler
+    public void onQuit(@NotNull PlayerQuitEvent event) {
+        remove(event.getPlayer().getUniqueId());
+    }
+
+    private void remove(@NotNull UUID playerId) {
+        final Entry removed = bars.remove(playerId);
+        if (removed != null) {
+            removed.bar().removeAll();
+        }
+    }
+
+    /** Cancels the timer and removes every indicator before plugin shutdown. */
+    public void shutdown() {
+        if (refreshTask != null) {
+            refreshTask.cancel();
+            refreshTask = null;
+        }
+        bars.values().forEach(entry -> entry.bar().removeAll());
+        bars.clear();
+    }
+}
diff --git a/src/main/java/com/gmail/nossr50/util/experience/XpBonusStatus.java b/src/main/java/com/gmail/nossr50/util/experience/XpBonusStatus.java
new file mode 100644
index 0000000..c5b4016
--- /dev/null
+++ b/src/main/java/com/gmail/nossr50/util/experience/XpBonusStatus.java
@@ -0,0 +1,121 @@
+package com.gmail.nossr50.util.experience;
+
+import com.gmail.nossr50.config.experience.ExperienceConfig;
+import com.gmail.nossr50.datatypes.experience.XPGainSource;
+import com.gmail.nossr50.datatypes.player.McMMOPlayer;
+import com.gmail.nossr50.datatypes.skills.PrimarySkillType;
+import com.gmail.nossr50.listeners.ListenerGuards;
+import com.gmail.nossr50.locale.LocaleLoader;
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.party.PartyTogetherBonus;
+import com.gmail.nossr50.util.PaperUtil;
+import com.gmail.nossr50.util.skills.SkillTools;
+import java.util.EnumMap;
+import java.util.Locale;
+import java.util.Map;
+import org.bukkit.GameMode;
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Read-only snapshot of configured XP bonus factors for eligible gameplay. These are not an
+ * estimate of an action's final award: base XP, skill formula modifiers, perks and caps are separate.
+ */
+public record XpBonusStatus(@NotNull State state, @NotNull Map<PrimarySkillType, Double> skillRates,
+        double globalMultiplier, double togetherMultiplier, double eventMultiplier,
+        double vanillaMultiplier, boolean vanillaSupported, boolean vanillaActive, boolean gameplayXpAllowed) {
+
+    public enum State {
+        ACTIVE, INACTIVE, GAME_MODE, FOLIA
+    }
+
+    public XpBonusStatus {
+        skillRates = Map.copyOf(skillRates);
+    }
+
+    /** Captures the same eligibility gates, Together calculation and effective rates as XP awards. */
+    public static @NotNull XpBonusStatus capture(@NotNull mcMMO plugin, @NotNull Player player) {
+        // The legacy party list reads other entities. Do not query it from a Folia region thread.
+        if (PaperUtil.isFolia()) {
+            return inactive(State.FOLIA);
+        }
+        final McMMOPlayer mmoPlayer = ListenerGuards.resolveEligiblePlayer(player);
+        if (mmoPlayer == null) {
+            return inactive(State.INACTIVE);
+        }
+        if (player.getGameMode() == GameMode.CREATIVE) {
+            return inactive(State.GAME_MODE);
+        }
+
+        final ExperienceConfig config = ExperienceConfig.getInstance();
+        final double together = PartyTogetherBonus.getSkillXpMultiplier(mmoPlayer, XPGainSource.SELF);
+        final boolean gameplayXpAllowed = ListenerGuards.canGainGameplayXp(player);
+        final Map<PrimarySkillType, Double> rates = new EnumMap<>(PrimarySkillType.class);
+        for (final PrimarySkillType skill : SkillTools.NON_CHILD_SKILLS) {
+            if (gameplayXpAllowed && plugin.getSkillTools().doesPlayerHaveSkillPermission(player, skill)) {
+                rates.put(skill, config.getExperienceGainsMultiplier(skill) * together);
+            }
+        }
+        final double event = plugin.getVanillaXpEventMultiplier();
+        final boolean vanillaSupported = plugin.isVanillaXpBonusSupported();
+        final boolean vanillaActive = vanillaSupported && player.getGameMode() != GameMode.SPECTATOR;
+        // The skill pipeline uses a float; green-bar awards use the configured double directly.
+        final double vanillaTogether = together > 1.0D
+                ? plugin.getGeneralConfig().getPartyTogetherBonusMultiplier() : 1.0D;
+        return new XpBonusStatus(State.ACTIVE, rates, config.getExperienceGainsGlobalMultiplier(),
+                together, event, vanillaActive ? event * vanillaTogether : 1.0D, vanillaSupported, vanillaActive,
+                gameplayXpAllowed);
+    }
+
+    private static @NotNull XpBonusStatus inactive(@NotNull State state) {
+        return new XpBonusStatus(state, Map.of(), 1.0D, 1.0D, 1.0D, 1.0D, false, false, false);
+    }
+
+    /** Returns a compact range when permitted skills have different effective rates. */
+    public @NotNull String skillRateText() {
+        if (!gameplayXpAllowed) {
+            return LocaleLoader.getString("XPBonus.Blocked");
+        }
+        if (skillRates.isEmpty()) {
+            return LocaleLoader.getString("XPBonus.Unavailable");
+        }
+        final double minimum = skillRates.values().stream().mapToDouble(Double::doubleValue).min().orElse(1.0D);
+        final double maximum = skillRates.values().stream().mapToDouble(Double::doubleValue).max().orElse(1.0D);
+        return approximatelyEqual(minimum, maximum) ? formatRate(minimum)
+                : LocaleLoader.getString("XPBonus.Range", formatRate(minimum), formatRate(maximum));
+    }
+
+    /** Builds the dedicated bossbar title without affecting ordinary skill progress bars. */
+    public @NotNull String title() {
+        if (state != State.ACTIVE) {
+            return LocaleLoader.getString("XPBonus.State." + state);
+        }
+        final boolean equalRates = vanillaActive && gameplayXpAllowed && !skillRates.isEmpty()
+                && skillRates.values().stream().allMatch(rate -> approximatelyEqual(rate, vanillaMultiplier));
+        final String rates = equalRates
+                ? LocaleLoader.getString("XPBonus.Bar.Same", formatRate(vanillaMultiplier))
+                : LocaleLoader.getString("XPBonus.Bar.Different", skillRateText(), greenRateText());
+        final String restrictions = gameplayXpAllowed ? "" : LocaleLoader.getString("XPBonus.GameplayBlocked.Short");
+        final boolean canReceiveBonus = vanillaActive || !skillRates.isEmpty();
+        final boolean weekend = canReceiveBonus && eventMultiplier > 1.0D;
+        final boolean together = canReceiveBonus && togetherMultiplier > 1.0D;
+        final String sources = weekend && together ? "WeekendTogether" : weekend ? "Weekend" : "Together";
+        return rates + (weekend || together ? LocaleLoader.getString("XPBonus.Sources." + sources) : "")
+                + restrictions;
+    }
+
+    /** Green-bar factors are shown only when the supported award pipeline can run in this mode. */
+    public @NotNull String greenRateText() {
+        return !vanillaSupported ? LocaleLoader.getString("XPBonus.Unavailable")
+                : !vanillaActive ? LocaleLoader.getString("XPBonus.Inactive") : formatRate(vanillaMultiplier);
+    }
+
+    private static boolean approximatelyEqual(double first, double second) {
+        return Math.abs(first - second) < 1.0E-6D;
+    }
+
+    /** Stable two-decimal multiplier text, independent of the server machine's locale. */
+    public static @NotNull String formatRate(double multiplier) {
+        return String.format(Locale.ROOT, "×%.2f", multiplier);
+    }
+}
