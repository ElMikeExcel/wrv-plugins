+        verify(player).sendMessage(contains("Green inactive"));
+        verify(player).sendMessage(contains("Eligible passive mcMMO gains"));
+        verify(player).sendMessage(contains("Mining:"));
+        verify(player, never()).sendMessage(contains("Green-bar gameplay orb bonus:"));
+    }
+
+}
