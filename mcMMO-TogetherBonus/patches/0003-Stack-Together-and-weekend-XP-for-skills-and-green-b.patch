@@ -0,0 +1,88 @@
+package com.gmail.nossr50.commands.player;
+
+import com.gmail.nossr50.datatypes.skills.PrimarySkillType;
+import com.gmail.nossr50.locale.LocaleLoader;
+import com.gmail.nossr50.mcMMO;
+import com.gmail.nossr50.util.commands.CommandUtils;
+import com.gmail.nossr50.util.experience.XpBonusIndicator;
+import com.gmail.nossr50.util.experience.XpBonusStatus;
+import com.gmail.nossr50.util.skills.SkillTools;
+import java.util.List;
+import java.util.Locale;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.command.TabExecutor;
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.NotNull;
+
+/** Player-facing, read-only XP status with a persistent visibility preference. */
+public final class XpBonusCommand implements TabExecutor {
+    private static final List<String> OPTIONS = List.of("status", "show", "hide", "toggle");
+
+    @Override
+    public boolean onCommand(@NotNull CommandSender sender, @NotNull Command command,
+            @NotNull String label, @NotNull String[] args) {
+        if (CommandUtils.noConsoleUsage(sender)) {
+            return true;
+        }
+        if (args.length > 1) {
+            return false;
+        }
+        final Player player = (Player) sender;
+        final String option = args.length == 0 ? "status" : args[0].toLowerCase(Locale.ROOT);
+        if (option.equals("status")) {
+            showStatus(player);
+            return true;
+        }
+        if (!OPTIONS.contains(option)) {
+            return false;
+        }
+        final XpBonusIndicator indicator = mcMMO.p.getXpBonusIndicator();
+        if (indicator == null) {
+            player.sendMessage(LocaleLoader.getString("XPBonus.IndicatorUnavailable"));
+            return true;
+        }
+        final boolean visible = option.equals("show") || option.equals("toggle") && !indicator.isVisible(player);
+        indicator.setVisible(player, visible);
+        player.sendMessage(LocaleLoader.getString(visible ? "XPBonus.Show" : "XPBonus.Hide"));
+        if (visible && (!mcMMO.p.getGeneralConfig().isXpBonusIndicatorEnabled()
+                || XpBonusStatus.capture(mcMMO.p, player).state() == XpBonusStatus.State.FOLIA)) {
+            player.sendMessage(LocaleLoader.getString("XPBonus.IndicatorUnavailable"));
+        }
+        return true;
+    }
+
+    private void showStatus(@NotNull Player player) {
+        final XpBonusStatus status = XpBonusStatus.capture(mcMMO.p, player);
+        player.sendMessage(status.title());
+        if (status.state() != XpBonusStatus.State.ACTIVE) {
+            return;
+        }
+        player.sendMessage(LocaleLoader.getString("XPBonus.Factors",
+                XpBonusStatus.formatRate(status.globalMultiplier()), XpBonusStatus.formatRate(status.togetherMultiplier())));
+        if (status.vanillaActive()) {
+            player.sendMessage(LocaleLoader.getString("XPBonus.Green", status.greenRateText()));
+        } else {
+            player.sendMessage(LocaleLoader.getString(status.vanillaSupported()
+                    ? "XPBonus.GreenInactive" : "XPBonus.GreenUnavailable"));
+        }
+        if (!status.gameplayXpAllowed()) {
+            player.sendMessage(LocaleLoader.getString("XPBonus.GameplayBlocked"));
+        }
+        for (final PrimarySkillType skill : SkillTools.NON_CHILD_SKILLS) {
+            final Double rate = status.skillRates().get(skill);
+            player.sendMessage(LocaleLoader.getString("XPBonus.Skill",
+                    mcMMO.p.getSkillTools().getLocalizedSkillName(skill),
+                    rate == null ? LocaleLoader.getString(status.gameplayXpAllowed()
+                            ? "XPBonus.NoPermission" : "XPBonus.Blocked") : XpBonusStatus.formatRate(rate)));
+        }
+        player.sendMessage(LocaleLoader.getString("XPBonus.Scope"));
+    }
+
+    @Override
+    public @NotNull List<String> onTabComplete(@NotNull CommandSender sender, @NotNull Command command,
+            @NotNull String alias, @NotNull String[] args) {
+        return args.length == 1 ? OPTIONS.stream()
+                .filter(option -> option.startsWith(args[0].toLowerCase(Locale.ROOT))).toList() : List.of();
+    }
+}
