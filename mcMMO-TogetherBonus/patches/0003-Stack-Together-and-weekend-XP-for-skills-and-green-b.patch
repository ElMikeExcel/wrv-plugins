+    @Test
+    void defaultStatusShouldIncludeExactSkillRateGreenRateAndScope() {
+        assertThat(executor.onCommand(player, command, "xpbonus", new String[0])).isTrue();
+        verify(player).sendMessage(contains("Mining:"));
+        verify(player, atLeastOnce()).sendMessage(contains("×2.50"));
+        verify(player).sendMessage(contains("Green-bar gameplay orb bonus: ×1.50"));
+        verify(player).sendMessage(contains("Bonus factors only"));
+    }
+
+    @Test
+    void showHideAndToggleShouldChangeOnlyThePlayersPreference() {
+        executor.onCommand(player, command, "xpbonus", new String[]{"show"});
+        verify(indicator).setVisible(player, true);
+        executor.onCommand(player, command, "xpbonus", new String[]{"hide"});
+        verify(indicator).setVisible(player, false);
+        when(indicator.isVisible(player)).thenReturn(true);
+        executor.onCommand(player, command, "xpbonus", new String[]{"toggle"});
+        verify(indicator, times(2)).setVisible(player, false);
+    }
+
+    @Test
+    void invalidArgumentsShouldReturnUsageAndTabCompletionShouldBeBounded() {
+        assertThat(executor.onCommand(player, command, "xpbonus", new String[]{"bogus"})).isFalse();
