+        assertThat(executor.onCommand(console, command, "xpbonus", new String[0])).isTrue();
+        verify(console).sendMessage(anyString());
+    }
+
+    @Test
+    void unsupportedGreenShouldUseAnUnavailableLabelWithoutNumericClaim() {
