+        executor.onCommand(player, command, "xpbonus", new String[0]);
+        verify(player).sendMessage(contains("Green unavailable"));
+        verify(player).sendMessage(contains("Green-bar bonuses are unavailable"));
+        verify(player, never()).sendMessage(contains("Green-bar gameplay orb bonus:"));
+    }
+
+    @Test
+    void spectatorShouldExplainPassiveSkillFactorsWithoutClaimingGreenBonus() {
+        when(player.getGameMode()).thenReturn(GameMode.SPECTATOR);
